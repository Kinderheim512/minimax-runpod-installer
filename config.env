#!/usr/bin/env bash
# config.env — configuration centrale de l'installateur MiniMax H3 / ComfyUI.

# ============================================================================
# Chemins
# ============================================================================
INSTALL_DIR="${INSTALL_DIR:-/workspace/ComfyUI}"
VENV_DIR="${VENV_DIR:-${INSTALL_DIR}/venv}"

# ============================================================================
# Dépôts Git
# ============================================================================
# Dépôt canonique du projet (a déménagé de comfyanonymous/ComfyUI vers
# l'organisation Comfy-Org ; l'ancienne URL redirige toujours côté GitHub,
# mais on pointe directement sur la nouvelle pour éviter de dépendre de ce
# redirect).
COMFYUI_REPO="${COMFYUI_REPO:-https://github.com/Comfy-Org/ComfyUI.git}"

# COMFYUI_RELEASE_MODE contrôle ce que suit l'installeur :
#   - "release" (défaut) : la dernière release stable GitHub (tag "vX.Y.Z",
#     cf. https://github.com/Comfy-Org/ComfyUI/releases), résolue via
#     `git ls-remote --tags` (pas de dépendance à l'API GitHub ni à jq, donc
#     pas de rate-limit). Installation reproductible d'un jour à l'autre pour
#     une même release, et jamais de commit master non testé.
#   - "branch" : ancien comportement — dernier commit de ${COMFYUI_BRANCH},
#     potentiellement différent d'un jour à l'autre.
# Si aucun tag n'est trouvé (réseau, dépôt sans release...), on retombe sur
# ${COMFYUI_BRANCH} avec un avertissement.
COMFYUI_RELEASE_MODE="${COMFYUI_RELEASE_MODE:-release}"
COMFYUI_BRANCH="${COMFYUI_BRANCH:-master}"
MIN_COMFYUI_VERSION="${MIN_COMFYUI_VERSION:-0.30.0}"

# Épinglage optionnel sur un commit précis de ComfyUI, pour une installation
# reproductible au commit près. Prioritaire sur COMFYUI_RELEASE_MODE : si
# COMFYUI_COMMIT est renseigné, ce commit exact est checkout juste après le
# clone ou la mise à jour, quel que soit le tag/branche résolu par
# COMFYUI_RELEASE_MODE — utile pour valider une régression (comparer un
# commit connu-bon à HEAD) ou figer une installation validée à un commit
# plus précis qu'une release taguée.
#   COMFYUI_COMMIT="a1b2c3d..."
COMFYUI_COMMIT="${COMFYUI_COMMIT:-}"

COMFYUI_MANAGER_REPO="${COMFYUI_MANAGER_REPO:-https://github.com/ltdrdata/ComfyUI-Manager.git}"

INSTALL_OPTIONAL_NODES="${INSTALL_OPTIONAL_NODES:-true}"
OPTIONAL_NODE_REPOS=(
  "https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git"
  "https://github.com/rgthree/rgthree-comfy.git"
  "https://github.com/kijai/ComfyUI-KJNodes.git"
  "https://github.com/M1kep/ComfyLiterals.git"
)

# Dépôts volontairement sans dépendance Python : requirements.txt n'est
# jamais recherché ni installé pour ces dépôts (voir lib/nodes.sh).
# ComfyUI-SolAttn_triton : nœud d'attention Sol-Attn (Triton), pas de
# requirements.txt dans le dépôt — s'appuie sur le Triton déjà fourni par
# l'installation PyTorch existante du projet, comme Spectrum ci-dessous.
OPTIONAL_NODE_REPOS_NO_PIP=(
  "https://github.com/kijai/ComfyUI-SolAttn_triton.git"
)

# ============================================================================
# SageAttention
# ============================================================================
# SageAttention (thu-ml) accélère l'attention quantifiée et réduit le pic
# VRAM des nœuds MiniMax H3 qui en dépendent (PathchSageAttentionKJ,
# MiniMaxH3MemoryEfficientSageAttentionPatch — fournis par ComfyUI-KJNodes,
# déjà installé via OPTIONAL_NODE_REPOS ci-dessus). Sans ce paquet Python,
# ces deux nœuds échouent avec "No module named 'sageattention'" et H3
# retombe sur --use-pytorch-cross-attention, nettement plus gourmand en
# VRAM — cause la plus fréquente des CUDA OOM observés sur H3 Reference-to-
# Video à VRAM tout juste suffisante (cf. TROUBLESHOOTING.md).
#
# Aucun wheel officiel n'est publié pour toutes les combinaisons torch/CUDA
# (cf. lib/python.sh::install_sageattention) : le paquet est donc compilé
# depuis les sources sur le pod lui-même, ce qui suppose un compilateur CUDA
# (nvcc) correspondant au runtime CUDA détecté. build-essential est déjà
# installé par install_system_packages (lib/system.sh) ; nvcc lui-même,
# lorsqu'il manque, est installé via le paquet apt cuda-toolkit-<version>
# (~3-4 Go de téléchargement, ~7 Go de disque — non négligeable sur un
# volume réseau contraint). La compilation elle-même prend 10-20 minutes.
# Résultat mis en cache dans SAGEATTENTION_CACHE_DIR pour ne jamais recloner/
# recompiler à une réinstallation ultérieure (seule une modification des
# sources en amont déclenche une recompilation, via `git pull`).
#
# Valeurs possibles :
#   auto  (défaut) : tente l'installation uniquement si le GPU détecté a une
#           compute capability >= SAGEATTENTION_MIN_COMPUTE_CAP (Ampere ou
#           plus récent — architectures sur lesquelles SageAttention est
#           documenté comme supporté). Échec non bloquant : install.sh
#           continue même si la compilation échoue (log_warn, workflow
#           utilisable sans, juste plus lent / plus gourmand en VRAM).
#   true  : force la tentative d'installation quelle que soit la compute
#           capability détectée (déconseillé sous Ampere, non testé en amont).
#   false : ne tente jamais l'installation (utile si vous préférez gérer ce
#           paquet vous-même, ou sur un GPU où il ne s'applique pas).
SAGE_ATTENTION="${SAGE_ATTENTION:-auto}"

# Seuil de compute capability utilisé par SAGE_ATTENTION=auto ci-dessus.
# 8.0 = Ampere (A6000, A100, RTX 30xx...) et plus récent.
SAGEATTENTION_MIN_COMPUTE_CAP="${SAGEATTENTION_MIN_COMPUTE_CAP:-8.0}"

SAGEATTENTION_REPO="${SAGEATTENTION_REPO:-https://github.com/thu-ml/SageAttention.git}"

# Par défaut, un cache SageAttention déjà cloné (SAGEATTENTION_CACHE_DIR)
# n'est JAMAIS mis à jour automatiquement — install.sh/update.sh compilent
# la version déjà présente sur le pod telle quelle, même à l'occasion d'un
# update.sh, plutôt que de récupérer silencieusement la dernière révision en
# amont. Une régression ou un changement de comportement upstream ne doit
# jamais surprendre une installation qui fonctionne déjà sur un GPU donné.
#   false (défaut) : ne touche jamais au cache existant (pas de `git pull`).
#   true            : autorise `git pull --ff-only` sur le cache existant
#           avant recompilation — à activer ponctuellement pour tester une
#           mise à jour en connaissance de cause, pas comme réglage permanent.
SAGEATTENTION_UPDATE="${SAGEATTENTION_UPDATE:-false}"

# Cloné/compilé une seule fois ici (hors ${INSTALL_DIR}, donc jamais
# supprimé par un ./uninstall.sh qui ne toucherait qu'à ComfyUI) puis
# installé en editable (`pip install -e .`) dans le venv du projet.
SAGEATTENTION_CACHE_DIR="${SAGEATTENTION_CACHE_DIR:-${PROJECT_ROOT}/.cache/SageAttention}"

# Parallélisme de compilation (cf. flags EXT_PARALLEL / NVCC_APPEND_FLAGS /
# MAX_JOBS documentés par thu-ml/SageAttention). Réduisez si le pod a peu de
# CPU/RAM et que la compilation échoue avec un signal "Killed" (OOM du
# compilateur, pas de la VRAM).
SAGEATTENTION_BUILD_JOBS="${SAGEATTENTION_BUILD_JOBS:-32}"

# ============================================================================
# Turbo LoRA MiniMax H3
# ============================================================================
# Téléchargement automatique (best-effort, jamais bloquant) du Turbo LoRA
# utilisé par le nœud MiniMaxH3TurboLoRA (fourni par le custom node
# ComfyUI-MiniMax-H3-Turbo, voir MINIMAX_H3_TURBO_NODE_REPO ci-dessous).
# Réutilise install_lora.sh tel quel (voir lib/lora_auto.sh) : idempotent
# nativement (fichier déjà présent -> aucun téléchargement), jamais de mise
# à jour automatique.
#
#   true  (défaut) : tente le téléchargement si le fichier cible est absent.
#   false           : ne télécharge jamais, quelle que soit la présence du
#           fichier — utile pour désactiver complètement cette étape.
MINIMAX_H3_TURBO_LORA_AUTO_DOWNLOAD="${MINIMAX_H3_TURBO_LORA_AUTO_DOWNLOAD:-true}"

# Source : Hugging Face, dépôt drbaph/MiniMax-H3-Turbo-Lora-ComfyUI —
# conversion tierce du Turbo LoRA original (larryvrh/MiniMax-H3-Turbo-Lora)
# rendue compatible avec le checkpoint H3 **pruned/curve-form**
# (minimax_h3_ref2va_pruned_int8_convrot.safetensors) : le LoRA d'origine ne
# charge pas tel quel sur un checkpoint pruned (couche AdaLN/time-
# conditioning incompatible). Fichier utilisé : la version "v4 step-600
# EMA", recommandée par ce dépôt pour un usage général (8 steps, sampler
# euler, scheduler beta).
#
# ATTENTION (2026-08) : le palier "balanced" utilise désormais
# minimax_h3_ref2va_pruned_fp8_scaled.safetensors (voir lib/models.sh), pas
# le checkpoint pruned/curve-form ci-dessus contre lequel ce LoRA a été
# validé. La compatibilité de ce LoRA avec fp8_scaled n'est PAS vérifiée —
# changement fait sciemment, à la demande explicite de l'utilisateur, qui
# assume le risque que le nœud MiniMaxH3TurboLoRA échoue à charger
# (incompatibilité AdaLN potentiellement toujours présente). En cas
# d'échec : soit re-télécharger manuellement
# minimax_h3_ref2va_pruned_int8_convrot.safetensors pour ce workflow
# précis, soit désactiver MINIMAX_H3_TURBO_LORA_AUTO_DOWNLOAD.
MINIMAX_H3_TURBO_LORA_URL="${MINIMAX_H3_TURBO_LORA_URL:-https://huggingface.co/drbaph/MiniMax-H3-Turbo-Lora-ComfyUI/resolve/main/minimax_h3_turbo_v4_step600_ema_pruned_comfyui.safetensors}"

# Nom local explicite du fichier une fois dans models/loras/. Sans cette
# variable (vide), install_lora.sh retombe sur son comportement historique
# (nom résolu depuis l'en-tête Content-Disposition pour CivitAI, ou dernier
# segment de l'URL pour un lien direct comme celui-ci) — voir --filename
# dans install_lora.sh. Fixée ici pour que ComfyUI affiche systématiquement
# ce nom stable dans le nœud MiniMaxH3TurboLoRA, quelle que soit l'URL
# source, et pour permettre l'idempotence sans recontacter Hugging
# Face/CivitAI uniquement pour redéterminer un nom déjà connu.
MINIMAX_H3_TURBO_LORA_FILENAME="${MINIMAX_H3_TURBO_LORA_FILENAME:-minimax_h3_turbo_v4_step600_ema_pruned_comfyui.safetensors}"

# ============================================================================
# Custom node Turbo MiniMax H3
# ============================================================================
# Dépôt fournissant les nœuds MiniMaxH3TurboLoRA et MiniMaxH3TurboSampler
# utilisés par les workflows Turbo. Installation volontairement séparée de
# OPTIONAL_NODE_REPOS(_NO_PIP) ci-dessus (lib/nodes.sh) : ces tableaux
# déclenchent un `git pull --ff-only` à chaque exécution d'install.sh/
# update.sh sur les dépôts déjà présents, alors que ce node Turbo doit
# rester figé une fois installé (pas de mise à jour automatique tant
# qu'elle n'est pas explicitement demandée — voir lib/lora_auto.sh::
# install_turbo_node()). Aucune dépendance Python (pas de requirements.txt
# dans ce dépôt), donc aucun pip install associé.
#
#   true  (défaut) : clone le dépôt s'il est absent.
#   false           : ne clone jamais — utile pour gérer ce node soi-même
#           (ComfyUI-Manager, installation manuelle...).
MINIMAX_H3_TURBO_NODE_AUTO_INSTALL="${MINIMAX_H3_TURBO_NODE_AUTO_INSTALL:-true}"
MINIMAX_H3_TURBO_NODE_REPO="${MINIMAX_H3_TURBO_NODE_REPO:-https://github.com/larryvrh/ComfyUI-MiniMax-H3-Turbo.git}"

# ============================================================================
# Composants optionnels
# ============================================================================
# Spectrum MiniMax H3 — nœud d'accélération optionnel pour MiniMax H3.
# Aucune dépendance Python (pas de requirements.txt dans ce dépôt) : il est
# donc ajouté à OPTIONAL_NODE_REPOS_NO_PIP plutôt qu'à OPTIONAL_NODE_REPOS.
# Mettre à "false" pour le désactiver complètement.
INSTALL_SPECTRUM="${INSTALL_SPECTRUM:-true}"
SPECTRUM_REPO="${SPECTRUM_REPO:-https://github.com/xmarre/ComfyUI-Spectrum-MiniMax-H3.git}"
if [[ "$INSTALL_SPECTRUM" == "true" ]]; then
  OPTIONAL_NODE_REPOS_NO_PIP+=("$SPECTRUM_REPO")
fi

# ============================================================================
# MiniMax H3
# ============================================================================
H3_HF_REPO="${H3_HF_REPO:-Comfy-Org/MiniMax-H3}"

# Dépôt HuggingFace tiers hébergeant les poids INT4 (palier "light" — voir
# H3_DIFFUSION_FL2VA/REF2VA dans lib/models.sh). Introduit pour que le projet
# ne dépende plus d'un unique dépôt : chaque entrée du manifeste des modèles
# porte désormais son propre dépôt (repo+filename), résolu et vérifié
# dynamiquement (licence, accès) par lib/huggingface.sh — voir
# hf_check_required_access(). Ajouter un futur dépôt tiers ne nécessite donc
# aucun hack : juste une nouvelle entrée de manifeste pointant vers lui.
H3_HF_REPO_INT4="${H3_HF_REPO_INT4:-tsolful/Minimax_H3_INT4MixedConvRot}"

# Workflows à installer
H3_WORKFLOWS="${H3_WORKFLOWS:-all}"

# Palier de poids par défaut. "auto" détecte la VRAM du GPU et choisit le
# palier le plus lourd qu'elle peut tenir, avec une marge de sécurité (voir
# H3_TIER_VRAM_SAFETY_MARGIN_GB dans la section GPU ci-dessous et
# lib/gpu.sh::detect_gpu). --tier=light / --tier=pruned /
# --tier=pruned_scaled / --tier=balanced / --tier=max (ou H3_TIER=...)
# forcent toujours un palier explicite, prioritaire sur l'auto-détection.
# "pruned_scaled" n'est jamais choisi par "auto" (repli manuel uniquement,
# voir lib/gpu.sh).
#
# Historique : ce projet ciblait à l'origine une RTX A6000 (48 Go) avec
# "max" figé par défaut. Des essais réels ont montré un OOM systématique sur
# cette carte avec ce palier (poids BF16) : pic mesuré ~48.2 Go pour 48 Go de
# VRAM disponible. La marge de sécurité ci-dessous corrige ce cas (et tout
# GPU de la même classe VRAM, ex. L40S, RTX 6000 Ada) sans toucher aux GPU
# qui ont réellement la VRAM pour "max" (A100/H100/H200).
H3_TIER="${H3_TIER:-auto}"

############################################################
# Model source
############################################################
MODEL_SOURCE="${MODEL_SOURCE:-huggingface}"
# Available values:
# huggingface
# civitai

# URLs CivitAI des modèles de diffusion (pruned INT8 ConvRot uniquement —
# seuls fichiers disponibles côté CivitAI pour H3). Depuis l'introduction du
# palier "light" en INT4Q (dépôt HuggingFace uniquement, voir H3_HF_REPO_INT4
# ci-dessus), ces poids pruned INT8 correspondent au palier "balanced", plus
# à "light" — MODEL_SOURCE=civitai n'est donc utilisable qu'avec
# H3_TIER=balanced (voir garde dans download_h3_models(), lib/models.sh).
# Utilisées uniquement si MODEL_SOURCE=civitai.
H3_CIVITAI_FL2VA_URL="${H3_CIVITAI_FL2VA_URL:-https://civitai.red/api/download/models/3193337?fileId=3074134}"
H3_CIVITAI_REF2VA_URL="${H3_CIVITAI_REF2VA_URL:-https://civitai.red/api/download/models/3193385?fileId=3074237}"

# ============================================================================
# Presets (jeux de modèles additionnels pour un workflow particulier)
# ============================================================================
# Un preset télécharge un jeu de fichiers modèles précis (souvent hors des
# trois paliers H3_TIER standard — checkpoints expérimentaux, dépôts tiers,
# etc.) et installe le workflow ComfyUI correspondant, EN PLUS de
# l'installation standard (palier H3_TIER + workflows H3_WORKFLOWS), sans
# jamais la modifier — SAUF pour les presets listés dans
# H3_PRESET_REPLACES_STANDARD_TIER ci-dessous (cf. juste en dessous). Ne rien
# renseigner ici (H3_PRESETS vide) reproduit exactement le comportement
# historique du projet.
#
# Activation : H3_PRESETS="aistudynow" (config.env) ou --preset=aistudynow
# (ligne de commande, install.sh) — liste séparée par des virgules pour en
# activer plusieurs à la fois (ex. --preset=aistudynow,autre_preset). Un
# jeton inconnu est ignoré avec un avertissement (voir resolve_h3_presets()
# dans lib/presets.sh), jamais une erreur bloquante.
#
# Défaut du projet (2026-08) : "dasiwa_mmh3v12" — décision explicite de
# l'utilisateur, qui juge ce workflow tiers (darksidewalker/DaSiWa-Nodes)
# suffisamment bon pour en faire l'usage principal. Repasser à vide pour
# revenir au comportement d'origine (aucun preset actif par défaut).
# NOTE : expansion SANS ":" (${H3_PRESETS-...}, pas "${H3_PRESETS:-...}")
# volontaire — un "${VAR:-défaut}" remplacerait aussi une valeur VIDE
# explicite par le défaut, ce qui empêcherait justement de désactiver le
# preset par défaut via H3_PRESETS="" (env) ou --preset= sans valeur. Seule
# une variable réellement NON définie doit recevoir "dasiwa_mmh3v12".
H3_PRESETS="${H3_PRESETS-dasiwa_mmh3v12}"

# Registre des presets connus — seule liste consultée pour valider
# H3_PRESETS/--preset= et composer les messages d'avertissement. Ajouter un
# preset : un nouveau nom ici, un tableau PRESET_<NOM_MAJUSCULE> ci-dessous
# (manifeste "repo|chemin_dans_le_repo|sous-dossier_local_models"), et
# éventuellement une entrée dans H3_PRESET_WORKFLOWS. Rien d'autre à modifier
# (lib/presets.sh reste générique).
H3_PRESET_NAMES=(aistudynow dasiwa_mmh3v12 minimaxh3auto_v5)

# Presets qui fournissent EUX-MÊMES un jeu complet fl2va/ref2va/text encoder
# (sous une autre précision/dépôt que le palier H3_TIER standard) plutôt que
# de simplement compléter l'install standard. Pour ceux-ci, retélécharger EN
# PLUS le palier H3_TIER standard ne ferait que dupliquer ~40-80 Go de poids
# qui remplissent le même rôle (fl2va/ref2va/text encoder) sous une
# précision différente, pour aucun bénéfice — donc install.sh saute
# entièrement download_h3_models() quand un preset de cette liste est actif
# (voir preset_replaces_standard_tier(), lib/presets.sh, et les deux points
# d'appel dans install.sh). "aistudynow" et "minimaxh3auto_v5" n'y figurent
# PAS : ils sont authentiquement additifs (aistudynow dédupe déjà son text
# encoder/VAE avec le palier standard car il pointe vers les mêmes
# repo+chemin ; son diffusion model w4a8_mixed sert un rôle différent, pas
# un doublon de fl2va/ref2va).
# shellcheck disable=SC2034  # lu par lib/presets.sh
H3_PRESET_REPLACES_STANDARD_TIER=(dasiwa_mmh3v12)

# --- Preset "aistudynow" ----------------------------------------------------
# Checkpoint expérimental W4A8 MiniMax H3 Reference-to-Video (dépôt
# Kijai/MiniMax-H3-experimental) + VAE vidéo INT8 ConvRot associé + LoRA de
# référence rang 256, complétés par le text encoder NVFP4 AWQ et le VAE audio
# déjà utilisés par l'installation standard (dépôt Comfy-Org/MiniMax-H3 —
# retéléchargement sauté si déjà présents, download_hf_file() est idempotent).
# Format de chaque entrée : "repo|chemin_dans_le_repo|sous-dossier_local"
# (sous-dossier vide = le chemin dans le repo contient déjà le bon
# sous-dossier models/, ex. "vae/..."/"loras/..." — voir lib/presets.sh pour
# le détail de la résolution).
# shellcheck disable=SC2034  # lu par nameref dans lib/presets.sh
PRESET_AISTUDYNOW=(
  "Kijai/MiniMax-H3-experimental|minimax_h3_ref2va_pruned_w4a8_mixed.safetensors|diffusion_models"
  "Kijai/MiniMax-H3-experimental|minimax_h3_video_vae_int8_convrot.safetensors|vae"
  "Kijai/MiniMax-H3-experimental|loras/minimax_h3_ref_lora_rank_256_bf16.safetensors|"
  "Comfy-Org/MiniMax-H3|text_encoders/qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors|"
  "Comfy-Org/MiniMax-H3|vae/minimax_h3_audio_vae_fp32.safetensors|"
)

# --- Preset "dasiwa_mmh3v12" -------------------------------------------------
# Workflow "DaSiWa - MiniMaxH3 MythicAlchemy v12" (T2VA/I2VA/FLF2VA/REF2VA) —
# checkpoints ConvRot INT8 FL2VA + REF2VA (dépôt Comfy-Org/MiniMax-H3, hors
# des trois paliers H3_TIER standard qui n'exposent que bf16/fp8_scaled/
# INT4Q), text encoder alternatif INT4 ConvRot (dépôt Abiray/MiniMax-H3-GGUF,
# tel que sélectionné dans le node Settings du workflow), VAE vidéo fp16 +
# VAE audio fp32 (repris ici pour un preset autonome — retéléchargement
# sauté s'ils sont déjà présents via l'installation standard), le TAE
# (aperçu rapide, dépôt Kijai/MiniMax-H3-TAE), le modèle d'upscale optionnel
# (2x-AnimeSharpV4_RCAN, dépôt Kim2091/2x-AnimeSharpV4 — fichier à la racine
# du repo, donc sous-dossier local upscale_models explicite) et le modèle
# d'interpolation de frames optionnel (rife_v4.26, dépôt
# Comfy-Org/frame_interpolation — chemin déjà dans un sous-dossier
# frame_interpolation/, donc sous-dossier local vide).
# shellcheck disable=SC2034  # lu par nameref dans lib/presets.sh
PRESET_DASIWA_MMH3V12=(
  "Comfy-Org/MiniMax-H3|diffusion_models/minimax_h3_fl2va_pruned_int8_convrot.safetensors|"
  "Comfy-Org/MiniMax-H3|diffusion_models/minimax_h3_ref2va_pruned_int8_convrot.safetensors|"
  "Abiray/MiniMax-H3-GGUF|text_encoders/qwen3vl_32b_minimax_h3_int4_convrot.safetensors|"
  "Comfy-Org/MiniMax-H3|vae/minimax_h3_video_vae_fp16.safetensors|"
  "Comfy-Org/MiniMax-H3|vae/minimax_h3_audio_vae_fp32.safetensors|"
  "Kijai/MiniMax-H3-TAE|vae_approx/taeh3.safetensors|"
  "Kim2091/2x-AnimeSharpV4|2x-AnimeSharpV4_RCAN.safetensors|upscale_models"
  "Comfy-Org/frame_interpolation|frame_interpolation/rife_v4.26.safetensors|"
)

# Custom node requis par le workflow (nœuds DaSiWa_LTX2LoraLoader et le
# "Director"/"Guide" MiniMax H3 qui wrappe MiniMaxH3ImageToVideo /
# MiniMaxH3ReferenceToVideo) — dépôt darksidewalker/ComfyUI-DaSiWa-Nodes.
# Même logique que PRESET_MINIMAXH3AUTO_V5_NODE_REPOS ci-dessous : scopé à
# ce preset précis via install_preset_nodes() (lib/presets.sh), jamais dans
# OPTIONAL_NODE_REPOS (aucun autre workflow standard n'en a besoin).
# shellcheck disable=SC2034  # lu par nameref dans lib/presets.sh
PRESET_DASIWA_MMH3V12_NODE_REPOS=(
  "https://github.com/darksidewalker/ComfyUI-DaSiWa-Nodes.git"
)

# Les nœuds MiniMax H3 de DaSiWa-Nodes (UNETLoader/VAELoader du workflow)
# rangent leurs modèles dans un sous-dossier "MiniMaxH3/" (organisation
# propre à ce pack de nœuds — ex. "diffusion_models/MiniMaxH3/…"), alors que
# le manifeste PRESET_DASIWA_MMH3V12 ci-dessus les télécharge à la racine de
# diffusion_models/vae (chemin réel sur le dépôt Comfy-Org/MiniMax-H3, sans
# "MiniMaxH3"). Le manifeste ne peut pas exprimer ce renommage local sans
# casser l'URL de téléchargement (cf. commentaire de install_preset_symlinks(),
# lib/presets.sh) — d'où ces liens symboliques créés après coup, pour que le
# workflow retrouve ses 4 fichiers sans dupliquer ~25 Go sur disque.
# shellcheck disable=SC2034  # lu par nameref dans lib/presets.sh
PRESET_DASIWA_MMH3V12_SYMLINKS=(
  "diffusion_models/minimax_h3_fl2va_pruned_int8_convrot.safetensors|diffusion_models/MiniMaxH3/minimax_h3_fl2va_pruned_int8_convrot.safetensors"
  "diffusion_models/minimax_h3_ref2va_pruned_int8_convrot.safetensors|diffusion_models/MiniMaxH3/minimax_h3_ref2va_pruned_int8_convrot.safetensors"
  "vae/minimax_h3_video_vae_fp16.safetensors|vae/MiniMaxH3/minimax_h3_video_vae_fp16.safetensors"
  "vae/minimax_h3_audio_vae_fp32.safetensors|vae/MiniMaxH3/minimax_h3_audio_vae_fp32.safetensors"
)

# --- Preset "minimaxh3auto_v5" -----------------------------------------------
# Workflow "Minimax H3 Auto-Prompter" (T2VA/I2VA/L2VA/FL2VA/REF2V, avec
# rédaction de prompt assistée par un LLM local via le nœud LLMTextProcessor
# — dépôt custom node KingManiya/ComfyUI-LLM-text-processor. Déclaré ci-
# dessous dans PRESET_MINIMAXH3AUTO_V5_NODE_REPOS, PAS dans
# OPTIONAL_NODE_REPOS : ce nœud n'est utile qu'à ce preset précis (aucun
# autre workflow standard n'en dépend), donc il ne doit être cloné que quand
# "minimaxh3auto_v5" est explicitement actif (H3_PRESETS/--preset=), jamais
# lors d'une installation standard — voir install_preset_nodes() dans
# lib/presets.sh.
# Modèle LLM GGUF (DavidAU/Qwen3.6-27B-Fable-Fusion-711-Uncensored-Heretic-
# NM-DAU-NEO-MAX-MTP-GGUF) + son projecteur vision mmproj-F16, tous deux à
# la racine du dépôt -> sous-dossier local LLM explicite (dossier attendu
# par LLMTextProcessor, cf. son README : ComfyUI/models/LLM).
#
# Text encoder CLIP "Qwen3.5-9B-abliterated" (nœud CLIPLoader, section REF2V
# avec entrée vidéo/audio) — dépôt confirmé par l'utilisateur : fichier
# unique à la racine (pas de shards model-0000X-of-0000Y), donc sous-dossier
# local text_encoders explicite (cf. note du workflow : "Goes into folder
# ComfyUI\models\text_encoders").
# ATTENTION — MISMATCH DE NOM inévitable avec ce système de presets : le
# fichier réel sur le dépôt s'appelle "model.safetensors" (basename du
# chemin repo -> nom local final, cf. lib/download.sh::download_hf_file, qui
# ne renomme jamais), mais le nœud CLIPLoader du workflow a figé le nom
# "Qwen3.5-9B-abliterated.safetensors" dans son widget. Une fois le
# téléchargement fait, renommer manuellement le fichier avant de lancer
# ComfyUI (ou resélectionner "model.safetensors" dans le dropdown du nœud) :
#   mv ComfyUI/models/text_encoders/model.safetensors \
#      ComfyUI/models/text_encoders/Qwen3.5-9B-abliterated.safetensors
# shellcheck disable=SC2034  # lu par nameref dans lib/presets.sh
PRESET_MINIMAXH3AUTO_V5=(
  "DavidAU/Qwen3.6-27B-Fable-Fusion-711-Uncensored-Heretic-NM-DAU-NEO-MAX-MTP-GGUF|Qwen3.6-27B-Fable-Fus-711-UnHeretic-NM-DAU-NEO-MAX-NEO-IQ2_M.gguf|LLM"
  "DavidAU/Qwen3.6-27B-Fable-Fusion-711-Uncensored-Heretic-NM-DAU-NEO-MAX-MTP-GGUF|mmproj-F16.gguf|LLM"
  "lukey03/Qwen3.5-9B-abliterated|model.safetensors|text_encoders"
)

# Nœud custom dédié à ce preset (cf. commentaire ci-dessus) — cloné/mis à
# jour uniquement quand "minimaxh3auto_v5" est actif, via
# install_preset_nodes() (lib/presets.sh). A un requirements.txt -> pip
# tenté automatiquement (même comportement que OPTIONAL_NODE_REPOS, pas
# OPTIONAL_NODE_REPOS_NO_PIP). ATTENTION — le setup automatique du binaire
# llama.cpp fourni par ce nœud ne couvre que Windows x64 + CUDA 13 (doc
# amont, et ggml-org ne publie même pas de build Linux+CUDA officiel) ; sur
# ce projet (Linux/RunPod) le binaire llama.cpp doit être mis en place
# manuellement après l'installation avant que le nœud ne fonctionne — voir
# le README du dépôt, section "llama.cpp".
# shellcheck disable=SC2034  # lu par nameref dans lib/presets.sh
PRESET_MINIMAXH3AUTO_V5_NODE_REPOS=(
  "https://github.com/KingManiya/ComfyUI-LLM-text-processor.git"
)

# Workflow ComfyUI installé automatiquement avec chaque preset (chemin
# relatif à la racine du projet). Copié tel quel dans
# ${INSTALL_DIR}/user/default/workflows par install_preset_workflows()
# (lib/presets.sh) — volontairement séparé de workflows/ et de
# install_workflows() (lib/workflows.sh), dont la ré-écriture de nom de
# fichier par palier (_patch_workflow_tier_filenames) ne doit jamais toucher
# aux noms de fichiers figés d'un preset.
declare -A H3_PRESET_WORKFLOWS=(
  [aistudynow]="presets/aistudynow/MiniMax_H3_REF2V_AIStudyNow.json"
  [dasiwa_mmh3v12]="presets/dasiwa_mmh3v12/DaSiWa_MiniMaxH3_MythicAlchemy_v12.json"
  [minimaxh3auto_v5]="presets/minimaxh3auto_v5/MinimaxH3Auto_v5.json"
)

# ============================================================================
# Téléchargement
# ============================================================================
# Hugging Face utilise exclusivement `hf download` (protocole Xet natif,
# voir lib/download.sh) — aria2c reste installé sur le système (lib/system.sh)
# pour un usage éventuel hors HF, mais n'est câblé à aucun téléchargement.
DOWNLOAD_MAX_RETRIES="${DOWNLOAD_MAX_RETRIES:-5}"

# Optimisations Hugging Face — HF_HUB_ENABLE_HF_TRANSFER a été retiré : cette
# variable est dépréciée et sans effet (silent no-op) dès lors que hf_xet est
# installé (cas par défaut depuis huggingface_hub>=0.32.0, voir requirements.txt) —
# tous les transferts passent alors par le protocole Xet, piloté par
# HF_XET_HIGH_PERFORMANCE ci-dessous. Voir CHANGELOG.md.
HF_XET_HIGH_PERFORMANCE="${HF_XET_HIGH_PERFORMANCE:-1}"

# Vérification SHA256 (laisser vide)
declare -A MODEL_SHA256=(
    [fl2va]=""
    [ref2va]=""
    [text_encoder]=""
    [video_vae]=""
    [audio_vae]=""
)

# ============================================================================
# Hugging Face
# ============================================================================
HF_TOKEN="${HF_TOKEN:-}"

# ============================================================================
# Stockage perso (LoRAs / presets / outputs), indépendant du Network Volume
# RunPod — voir lib/personal_storage.sh pour le mécanisme complet.
# ============================================================================
# PERSONAL_STORAGE_HF_REPO : dépôt Hugging Face de type "dataset", PRIVÉ, qui
# sert de coffre pour vos LoRAs perso (models/loras/personal/, distincts du
# Turbo LoRA officiel déposé directement dans models/loras/), vos presets
# perso (presets/personal/, distincts des presets versionnés dans ce repo)
# et vos outputs générés (output/) — trois choses que le Network Volume
# RunPod (payant, lié à un seul datacenter) n'est pas obligé de porter.
#
# Réutilise exactement le même token/la même authentification que
# lib/huggingface.sh (déjà utilisé pour télécharger les poids H3) : aucune
# nouvelle dépendance, aucun nouveau secret à gérer.
#
# Vide par défaut = fonctionnalité DÉSACTIVÉE (no-op silencieux dans
# sync_personal_storage_pull()/sync_personal_storage_push()). Pour l'activer :
#   1. Créez UNE FOIS, à la main, un dépôt privé sur https://huggingface.co
#      (type "Dataset"), ex: <votre-user>/minimax-runpod-perso — le compte
#      HF gratuit donne 100 Go de stockage privé, largement suffisant pour
#      cet usage (les poids H3, gérés séparément par lib/models.sh, n'ont pas
#      besoin d'être dupliqués ici).
#   2. Renseignez son identifiant ci-dessous, ex:
#        PERSONAL_STORAGE_HF_REPO="<votre-user>/minimax-runpod-perso"
# install.sh restaure ce coffre en tout début d'exécution (avant le
# lancement de ComfyUI) ; lancez `bash sync_push.sh` avant de terminate un
# pod pour y renvoyer vos ajouts (update.sh le fait aussi automatiquement en
# fin de mise à jour).
PERSONAL_STORAGE_HF_REPO="${PERSONAL_STORAGE_HF_REPO:-}"

# PERSONAL_LORAS_GITHUB_RELEASE_URL : backend SECONDAIRE et optionnel, pour
# un socle de LoRAs FIGÉS uniquement (contenu qui ne change plus) — jamais
# pour les outputs, qui s'accumulent et pour lesquels GitHub n'est pas fait
# (limite de 2 Go/fichier). URL de la PAGE d'une release GitHub, ex:
#   PERSONAL_LORAS_GITHUB_RELEASE_URL="https://github.com/<user>/<repo>/releases/tag/<tag>"
# Lecture seule : chaque asset de la release est téléchargé (une seule fois,
# skip si déjà présent) dans models/loras/personal/ via `curl`, sans
# authentification requise si le dépôt est public — jamais de push dessus
# depuis ce projet. Indépendant de PERSONAL_STORAGE_HF_REPO ci-dessus : les
# deux backends peuvent cohabiter (HF pour ce qui bouge, GitHub Releases pour
# un socle de LoRAs qu'on ne repousse jamais). Vide par défaut = désactivé.
PERSONAL_LORAS_GITHUB_RELEASE_URL="${PERSONAL_LORAS_GITHUB_RELEASE_URL:-}"

# ============================================================================
# GPU
# ============================================================================
MIN_VRAM_GB="${MIN_VRAM_GB:-8}"

# Seuils de VRAM brute (Go, tels que rapportés par nvidia-smi) au-delà
# desquels --tier=auto / H3_TIER=auto recommande "pruned", puis "balanced",
# puis "max". En dessous du seuil "pruned", "light" est utilisé. Gardez ces
# valeurs croissantes. "pruned_scaled" n'a volontairement pas de seuil ici :
# il n'est jamais choisi par auto (voir lib/gpu.sh), toujours manuel.
H3_TIER_MIN_VRAM_PRUNED_GB="${H3_TIER_MIN_VRAM_PRUNED_GB:-24}"
# "balanced" pointe maintenant vers pruned_bf16 (~40.2 Go, pleine précision
# élaguée) au lieu de l'ancien pruned_fp8_scaled (~21 Go) — seuil relevé en
# conséquence pour refléter le vrai besoin VRAM de ce palier.
H3_TIER_MIN_VRAM_BALANCED_GB="${H3_TIER_MIN_VRAM_BALANCED_GB:-40}"
H3_TIER_MIN_VRAM_MAX_GB="${H3_TIER_MIN_VRAM_MAX_GB:-48}"

# Marge de sécurité (Go) soustraite de la VRAM détectée avant de la comparer
# aux seuils ci-dessus. Le pic d'usage réel (allocateur CUDA, activations,
# overhead ComfyUI/PyTorch) dépasse la taille brute des poids : un GPU tout
# juste au seuil "max" (48 Go, ex. RTX A6000/L40S) peut donc OOM même s'il
# correspond nominalement au palier. Augmentez cette valeur si vous observez
# des OOM proches d'un changement de palier ; mettez-la à 0 pour retrouver
# les seuils bruts sans marge.
H3_TIER_VRAM_SAFETY_MARGIN_GB="${H3_TIER_VRAM_SAFETY_MARGIN_GB:-4}"

# --highvram côté ComfyUI garde en permanence tous les modèles (diffusion,
# text encoder, VAE) en VRAM et désactive l'offloading CPU<->GPU. Sur les
# workflows H3 Reference-to-Video, le pic réel dépasse régulièrement les
# 48 Go nominaux d'une RTX A6000 / RTX 6000 Ada, ce qui provoque un CUDA OOM
# systématique avec ce flag. Valeurs possibles :
#   auto  (défaut) : n'active --highvram que si la VRAM détectée, marge de
#           sécurité déduite (H3_TIER_VRAM_SAFETY_MARGIN_GB ci-dessus),
#           dépasse 48 Go (A100/H100/H200...) — pas sur les GPU 48 Go
#           tout juste au seuil.
#   true  : force --highvram quelle que soit la VRAM détectée.
#   false : force la gestion normale (jamais --highvram).
COMFY_HIGHVRAM="${COMFY_HIGHVRAM:-auto}"

# ComfyUI (fonctionnalité "Dynamic VRAM") verrouille en RAM hôte ("pin",
# mémoire page-lockée) jusqu'à ~90% de la RAM vue par le processus pendant
# le chargement des modèles, pour accélérer les transferts CPU->GPU. Sur un
# pod RunPod (ou tout hébergeur conteneurisé), la RAM "vue" par le processus
# est souvent celle de la machine hôte physique (des centaines de Go), pas
# la limite réellement allouée au pod par son cgroup (ex. 50 Go). Quand le
# cumul des poids page-lockés dépasse cette limite cgroup, le noyau tue le
# processus (SIGKILL, cgroup OOM) sans traceback Python ni erreur CUDA — cas
# diagnostiqué sur ce projet (RTX A6000, pod limité à 50 Go côté cgroup
# malgré 500+ Go visibles côté machine hôte, crash systématique juste après
# le chargement du modèle de diffusion). --disable-pinned-memory (flag
# officiel ComfyUI) évite ce mode de défaillance, au prix d'un chargement de
# modèle un peu plus lent (RAM classique, "swappable"). Valeurs possibles :
#   auto  (défaut) : ajoute --disable-pinned-memory uniquement si la limite
#           mémoire réellement détectée pour ce pod (cgroup v2/v1, avec
#           repli sur la RAM totale hôte si aucun cgroup n'est actif — voir
#           detect_system_ram() dans lib/gpu.sh) est sous
#           H3_MIN_RAM_FOR_PINNED_MEMORY_GB ci-dessous. Laisse le pinning
#           actif (perf max) sur les pods qui ont réellement la RAM pour.
#   true  : force --disable-pinned-memory quelle que soit la RAM détectée.
#   false : ne jamais désactiver le pinning (comportement ComfyUI par
#           défaut) — à réserver aux pods dont la RAM est garantie large.
COMFY_PINNED_MEMORY="${COMFY_PINNED_MEMORY:-auto}"

# Seuil (Go) utilisé par COMFY_PINNED_MEMORY=auto ci-dessus. Calibré sur le
# pic observé au palier de poids H3 le plus lourd ("max", BF16) chargé
# simultanément en RAM pinnée — VAE + text encoder + modèle de diffusion,
# ~60-65 Go avant marge — de façon à rester valable quel que soit le palier
# H3_TIER effectivement utilisé (un palier plus léger consommera moins,
# jamais plus). Le pinning ComfyUI ne verrouillant qu'~90% de la RAM
# détectée, un pod dont la limite mémoire dépasse ce seuil garde ~10% de
# marge structurelle en plus. Augmentez cette valeur si vous observez encore
# des SIGKILL proches du seuil ; réduisez-la si vous utilisez uniquement le
# palier "light" et voulez garder le pinning actif sur des pods plus petits.
H3_MIN_RAM_FOR_PINNED_MEMORY_GB="${H3_MIN_RAM_FOR_PINNED_MEMORY_GB:-80}"

# ComfyUI ("smart memory") garde en cache VRAM les modèles récemment
# utilisés au lieu de les décharger vers la RAM dès qu'ils ne servent plus,
# pour accélérer les générations consécutives. Sur les workflows H3 (32 Go
# de diffusion + 26 Go de text encoder int8 + VAE, chargés successivement),
# ce cache spéculatif laisse trop peu de marge VRAM au moment du décodage ou
# du sampling suivant sur une carte à 48 Go tout juste — OOM observés à la
# fois en sampling et en VAE decode, de façon non parfaitement reproductible
# d'un run à l'autre (dépend de ce que le cache a choisi de garder).
# --disable-smart-memory (flag officiel ComfyUI) force un déchargement
# immédiat des modèles inutilisés vers la RAM hôte au lieu de les garder en
# cache VRAM.
#
# Choix empirique, pas une règle générale de gestion mémoire ComfyUI :
# activé sur les machines à RAM large sur la base des tests effectués avec
# MiniMax H3 (RTX A6000 48 Go, RunPod, 500+ Go de RAM hôte) — a éliminé les
# OOM observés jusqu'à 15 s / 2.0 MP, contre des échecs fréquents et non
# reproductibles sans ce flag. Aucune garantie que ce comportement reste
# optimal si un futur ComfyUI change sa gestion mémoire ("smart memory"),
# ou pour d'autres modèles/workflows que MiniMax H3 — voir la note de
# portée ci-dessous.
#
# Ce n'est PAS un flag universellement bénéfique : sur une machine où la RAM
# hôte est elle-même la ressource contrainte (typiquement < 32 Go), forcer
# ce déchargement supplémentaire vers la RAM peut aggraver la pression
# mémoire plutôt que la soulager (cas documenté par des tiers sur RTX 3090 /
# 31 Go de RAM — voir TROUBLESHOOTING.md). Sur les pods RunPod visés
# par ce projet (RAM hôte très largement supérieure à ce que H3 utilise),
# ce cas ne s'applique pas.
#
# Portée : ce flag est un argument de lancement de main.py, donc appliqué à
# tout le process ComfyUI — pas seulement à MiniMax H3. Il n'a été testé que
# sur le pipeline H3 de ce projet ; si vous chargez d'autres modèles/
# workflows dans la même instance ComfyUI (via ComfyUI-Manager par ex.), ce
# flag s'appliquera à eux aussi, sans validation de notre part sur ces cas.
# Valeurs possibles :
#   auto  (défaut) : active --disable-smart-memory uniquement si la RAM
#           allouée à ce pod atteint H3_MIN_RAM_FOR_SMART_MEMORY_GB
#           ci-dessous — c'est-à-dire sur les pods déjà considérés "RAM
#           large" par ce projet. En dessous, laisse le comportement par
#           défaut de ComfyUI (pas de sur-déchargement forcé vers une RAM
#           elle-même limitée).
#   true  : force --disable-smart-memory quelle que soit la RAM détectée.
#   false : ne jamais l'ajouter (comportement ComfyUI par défaut) — utile si
#           un futur ComfyUI ou comfy-kitchen rend ce contournement inutile,
#           sans avoir à toucher au code.
COMFY_SMART_MEMORY="${COMFY_SMART_MEMORY:-auto}"

# Seuil (Go) utilisé par COMFY_SMART_MEMORY=auto ci-dessus. Décision
# indépendante de H3_MIN_RAM_FOR_PINNED_MEMORY_GB — les deux protègent
# contre des modes de défaillance différents (SIGKILL cgroup pendant le
# chargement pour l'un, pression RAM liée au déchargement forcé de modèles
# pour l'autre) et n'ont pas de raison de varier ensemble si de futurs tests
# montrent des besoins différents. Même valeur par défaut aujourd'hui car
# calibrée sur les mêmes tests initiaux (RTX A6000, RunPod).
H3_MIN_RAM_FOR_SMART_MEMORY_GB="${H3_MIN_RAM_FOR_SMART_MEMORY_GB:-80}"

# ============================================================================
# Lancement
# ============================================================================
COMFYUI_PORT="${COMFYUI_PORT:-8188}"
COMFYUI_LISTEN="${COMFYUI_LISTEN:-0.0.0.0}"

# Arguments supplémentaires ComfyUI
EXTRA_LAUNCH_ARGS="${EXTRA_LAUNCH_ARGS:---preview-method auto --enable-cors-header}"