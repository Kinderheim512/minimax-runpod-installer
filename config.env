#!/usr/bin/env bash
# config.env — configuration centrale de l'installateur MiniMax H3 / ComfyUI.

# ============================================================================
# Langue de l'installateur / Installer language
# ============================================================================
# "en" (défaut) ou "fr". Contrôle la langue de tous les messages affichés
# par wizard.sh, install.sh, launch.sh, etc. (voir lib/i18n.sh et
# lib/lang/{en,fr}.sh). Peut aussi être forcé ponctuellement sans éditer ce
# fichier : INSTALLER_LANG=fr bash wizard.sh
#
# "en" (default) or "fr". Controls the language of every message printed by
# wizard.sh, install.sh, launch.sh, etc. (see lib/i18n.sh and
# lib/lang/{en,fr}.sh). Can also be overridden for a single run without
# editing this file: INSTALLER_LANG=fr bash wizard.sh
INSTALLER_LANG="${INSTALLER_LANG:-en}"

# ============================================================================
# Chemins
# ============================================================================
INSTALL_DIR="${INSTALL_DIR:-/workspace/ComfyUI}"
VENV_DIR="${VENV_DIR:-${INSTALL_DIR}/venv}"

# ============================================================================
# Dépôts Git
# ============================================================================
# Dépôt canonique du projet (a déménagé de comfyanonymous/ComfyUI vers
# l'organisation Comfy-Org ; l'ancienne URL redirige toujours côté GitHub,
# mais on pointe directement sur la nouvelle pour éviter de dépendre de ce
# redirect).
COMFYUI_REPO="${COMFYUI_REPO:-https://github.com/Comfy-Org/ComfyUI.git}"

# COMFYUI_RELEASE_MODE contrôle ce que suit l'installeur :
#   - "release" (défaut) : la dernière release stable GitHub (tag "vX.Y.Z",
#     cf. https://github.com/Comfy-Org/ComfyUI/releases), résolue via
#     `git ls-remote --tags` (pas de dépendance à l'API GitHub ni à jq, donc
#     pas de rate-limit). Installation reproductible d'un jour à l'autre pour
#     une même release, et jamais de commit master non testé.
#   - "branch" : ancien comportement — dernier commit de ${COMFYUI_BRANCH},
#     potentiellement différent d'un jour à l'autre.
# Si aucun tag n'est trouvé (réseau, dépôt sans release...), on retombe sur
# ${COMFYUI_BRANCH} avec un avertissement.
COMFYUI_RELEASE_MODE="${COMFYUI_RELEASE_MODE:-release}"
COMFYUI_BRANCH="${COMFYUI_BRANCH:-master}"
MIN_COMFYUI_VERSION="${MIN_COMFYUI_VERSION:-0.30.0}"

# Épinglage optionnel sur un commit précis de ComfyUI, pour une installation
# reproductible au commit près. Prioritaire sur COMFYUI_RELEASE_MODE : si
# COMFYUI_COMMIT est renseigné, ce commit exact est checkout juste après le
# clone ou la mise à jour, quel que soit le tag/branche résolu par
# COMFYUI_RELEASE_MODE — utile pour valider une régression (comparer un
# commit connu-bon à HEAD) ou figer une installation validée à un commit
# plus précis qu'une release taguée.
#   COMFYUI_COMMIT="a1b2c3d..."
COMFYUI_COMMIT="${COMFYUI_COMMIT:-}"

COMFYUI_MANAGER_REPO="${COMFYUI_MANAGER_REPO:-https://github.com/ltdrdata/ComfyUI-Manager.git}"

INSTALL_OPTIONAL_NODES="${INSTALL_OPTIONAL_NODES:-true}"
OPTIONAL_NODE_REPOS=(
  "https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git"
  "https://github.com/rgthree/rgthree-comfy.git"
  "https://github.com/kijai/ComfyUI-KJNodes.git"
  "https://github.com/M1kep/ComfyLiterals.git"
)

# Dépôts volontairement sans dépendance Python : requirements.txt n'est
# jamais recherché ni installé pour ces dépôts (voir lib/nodes.sh).
# ComfyUI-SolAttn_triton : nœud d'attention Sol-Attn (Triton), pas de
# requirements.txt dans le dépôt — s'appuie sur le Triton déjà fourni par
# l'installation PyTorch existante du projet, comme Spectrum ci-dessous.
OPTIONAL_NODE_REPOS_NO_PIP=(
  "https://github.com/kijai/ComfyUI-SolAttn_triton.git"
)

# ============================================================================
# SageAttention
# ============================================================================
# SageAttention (thu-ml) accélère l'attention quantifiée et réduit le pic
# VRAM des nœuds MiniMax H3 qui en dépendent (PathchSageAttentionKJ,
# MiniMaxH3MemoryEfficientSageAttentionPatch — fournis par ComfyUI-KJNodes,
# déjà installé via OPTIONAL_NODE_REPOS ci-dessus). Sans ce paquet Python,
# ces deux nœuds échouent avec "No module named 'sageattention'" et H3
# retombe sur --use-pytorch-cross-attention, nettement plus gourmand en
# VRAM — cause la plus fréquente des CUDA OOM observés sur H3 Reference-to-
# Video à VRAM tout juste suffisante (cf. TROUBLESHOOTING.md).
#
# Aucun wheel officiel n'est publié pour toutes les combinaisons torch/CUDA
# (cf. lib/python.sh::install_sageattention) : le paquet est donc compilé
# depuis les sources sur le pod lui-même, ce qui suppose un compilateur CUDA
# (nvcc) correspondant au runtime CUDA détecté. build-essential est déjà
# installé par install_system_packages (lib/system.sh) ; nvcc lui-même,
# lorsqu'il manque, est installé via le paquet apt cuda-toolkit-<version>
# (~3-4 Go de téléchargement, ~7 Go de disque — non négligeable sur un
# volume réseau contraint). La compilation elle-même prend 10-20 minutes.
# Résultat mis en cache dans SAGEATTENTION_CACHE_DIR pour ne jamais recloner/
# recompiler à une réinstallation ultérieure (seule une modification des
# sources en amont déclenche une recompilation, via `git pull`).
#
# Valeurs possibles :
#   auto  (défaut) : tente l'installation uniquement si le GPU détecté a une
#           compute capability >= SAGEATTENTION_MIN_COMPUTE_CAP (Ampere ou
#           plus récent — architectures sur lesquelles SageAttention est
#           documenté comme supporté). Échec non bloquant : install.sh
#           continue même si la compilation échoue (log_warn, workflow
#           utilisable sans, juste plus lent / plus gourmand en VRAM).
#   true  : force la tentative d'installation quelle que soit la compute
#           capability détectée (déconseillé sous Ampere, non testé en amont).
#   false : ne tente jamais l'installation (utile si vous préférez gérer ce
#           paquet vous-même, ou sur un GPU où il ne s'applique pas).
SAGE_ATTENTION="${SAGE_ATTENTION:-auto}"

# Seuil de compute capability utilisé par SAGE_ATTENTION=auto ci-dessus.
# 8.0 = Ampere (A6000, A100, RTX 30xx...) et plus récent.
SAGEATTENTION_MIN_COMPUTE_CAP="${SAGEATTENTION_MIN_COMPUTE_CAP:-8.0}"

SAGEATTENTION_REPO="${SAGEATTENTION_REPO:-https://github.com/thu-ml/SageAttention.git}"

# Par défaut, un cache SageAttention déjà cloné (SAGEATTENTION_CACHE_DIR)
# n'est JAMAIS mis à jour automatiquement — install.sh/update.sh compilent
# la version déjà présente sur le pod telle quelle, même à l'occasion d'un
# update.sh, plutôt que de récupérer silencieusement la dernière révision en
# amont. Une régression ou un changement de comportement upstream ne doit
# jamais surprendre une installation qui fonctionne déjà sur un GPU donné.
#   false (défaut) : ne touche jamais au cache existant (pas de `git pull`).
#   true            : autorise `git pull --ff-only` sur le cache existant
#           avant recompilation — à activer ponctuellement pour tester une
#           mise à jour en connaissance de cause, pas comme réglage permanent.
SAGEATTENTION_UPDATE="${SAGEATTENTION_UPDATE:-false}"

# Cloné/compilé une seule fois ici (hors ${INSTALL_DIR}, donc jamais
# supprimé par un ./uninstall.sh qui ne toucherait qu'à ComfyUI) puis
# installé en editable (`pip install -e .`) dans le venv du projet.
SAGEATTENTION_CACHE_DIR="${SAGEATTENTION_CACHE_DIR:-${PROJECT_ROOT}/.cache/SageAttention}"

# Parallélisme de compilation (cf. flags EXT_PARALLEL / NVCC_APPEND_FLAGS /
# MAX_JOBS documentés par thu-ml/SageAttention). Réduisez si le pod a peu de
# CPU/RAM et que la compilation échoue avec un signal "Killed" (OOM du
# compilateur, pas de la VRAM).
SAGEATTENTION_BUILD_JOBS="${SAGEATTENTION_BUILD_JOBS:-32}"

# Pré-compilation dans l'image Docker (voir Dockerfile / docker-build-steps.sh
# ::bake_sageattention_wheel, lib/python.sh) : au lieu de compiler
# SageAttention depuis les sources à CHAQUE démarrage de conteneur (10-20 min,
# et c'est le scénario qui échoue souvent selon l'état du pod), l'image
# Docker peut la compiler UNE FOIS pendant le build (aucun GPU visible à ce
# moment-là) et embarquer la wheel .whl résultante. install_sageattention()
# installe alors directement cette wheel si son index CUDA correspond au
# torch réellement retenu au démarrage — sinon elle recompile normalement,
# exactement comme sur un pod nu sans image Docker (aucune régression).
#
# SAGEATTENTION_ARCH_LIST : architectures cibles (format TORCH_CUDA_ARCH_LIST)
# utilisées UNIQUEMENT pendant cette pré-compilation sans GPU — impossible de
# détecter la compute capability réelle via nvidia-smi à la construction de
# l'image, donc on fige explicitement une liste couvrant Ampere à Blackwell
# (cohérente avec SAGEATTENTION_MIN_COMPUTE_CAP=8.0 ci-dessus). Adaptez si
# vous ciblez un sous-ensemble de GPU connu à l'avance (wheel plus légère,
# compilation plus rapide).
SAGEATTENTION_ARCH_LIST="${SAGEATTENTION_ARCH_LIST:-8.0;8.6;8.9;9.0;12.0}"

# Répertoire, DANS l'image Docker, où la wheel pré-compilée (et son index
# CUDA associé, ex "cu130") sont stockés. Jamais utilisé par install.sh sur
# pod nu (ce répertoire n'existe simplement pas dans ce cas, donc
# install_sageattention() retombe silencieusement sur la compilation depuis
# les sources, comportement inchangé).
SAGEATTENTION_WHEEL_CACHE_DIR="${SAGEATTENTION_WHEEL_CACHE_DIR:-${PROJECT_ROOT}/.cache/sageattention-wheel}"

# SAGEATTENTION_DOCKER_BAKE contrôle UNIQUEMENT bake_sageattention_wheel()
# (étape de CONSTRUCTION de l'image Docker, docker-build-steps.sh) — c'est un
# réglage volontairement séparé de SAGE_ATTENTION ci-dessus (qui contrôle,
# lui, l'installation/compilation à l'exécution, sur pod nu comme dans un
# conteneur). Les deux se combinent ainsi librement :
#   - SAGEATTENTION_DOCKER_BAKE=true (défaut) + SAGE_ATTENTION=auto/true :
#     comportement par défaut de cette image — wheel pré-compilée au build,
#     installée sans compiler au démarrage du conteneur.
#   - SAGEATTENTION_DOCKER_BAKE=false + SAGE_ATTENTION=true : aucune wheel
#     dans l'image (build plus rapide/léger), mais chaque conteneur compile
#     quand même SageAttention depuis les sources à son démarrage — utile
#     pour itérer sur SAGEATTENTION_REPO sans reconstruire l'image à chaque
#     fois, ou pour garder des images plus petites/rapides à construire.
#   - SAGEATTENTION_DOCKER_BAKE=true + SAGE_ATTENTION=false : la wheel est
#     bien pré-compilée et présente dans l'image, mais aucun conteneur ne
#     l'installera (SAGE_ATTENTION=false coupe l'étape entière au démarrage,
#     avant même de regarder si une wheel pré-compilée existe) — utile si
#     vous voulez pouvoir réactiver SageAttention ponctuellement par pod
#     (SAGE_ATTENTION=true en variable d'environnement RunPod) sans jamais
#     attendre de compilation, tout en le laissant désactivé par défaut.
# Sans effet sur install.sh/update.sh (usage bash classique sur pod nu) :
# cette variable n'est lue que par bake_sageattention_wheel(), jamais
# appelée en dehors de docker-build-steps.sh.
SAGEATTENTION_DOCKER_BAKE="${SAGEATTENTION_DOCKER_BAKE:-true}"

# ============================================================================
# Turbo LoRA MiniMax H3
# ============================================================================
# Téléchargement automatique (best-effort, jamais bloquant) du Turbo LoRA
# utilisé par le nœud MiniMaxH3TurboLoRA (fourni par le custom node
# ComfyUI-MiniMax-H3-Turbo, voir MINIMAX_H3_TURBO_NODE_REPO ci-dessous).
# Réutilise install_lora.sh tel quel (voir lib/lora_auto.sh) : idempotent
# nativement (fichier déjà présent -> aucun téléchargement), jamais de mise
# à jour automatique.
#
#   true  (défaut) : tente le téléchargement si le fichier cible est absent.
#   false           : ne télécharge jamais, quelle que soit la présence du
#           fichier — utile pour désactiver complètement cette étape.
MINIMAX_H3_TURBO_LORA_AUTO_DOWNLOAD="${MINIMAX_H3_TURBO_LORA_AUTO_DOWNLOAD:-true}"

# Source : Hugging Face, dépôt drbaph/MiniMax-H3-Turbo-Lora-ComfyUI —
# conversion tierce du Turbo LoRA original (larryvrh/MiniMax-H3-Turbo-Lora)
# rendue compatible avec le checkpoint H3 **pruned/curve-form**
# (minimax_h3_ref2va_pruned_int8_convrot.safetensors) : le LoRA d'origine ne
# charge pas tel quel sur un checkpoint pruned (couche AdaLN/time-
# conditioning incompatible). Fichier utilisé : la version "v4 step-600
# EMA", recommandée par ce dépôt pour un usage général (8 steps, sampler
# euler, scheduler beta).
#
# ATTENTION (2026-08) : le palier "balanced" utilise désormais
# minimax_h3_ref2va_pruned_fp8_scaled.safetensors (voir lib/models.sh), pas
# le checkpoint pruned/curve-form ci-dessus contre lequel ce LoRA a été
# validé. La compatibilité de ce LoRA avec fp8_scaled n'est PAS vérifiée —
# changement fait sciemment, à la demande explicite de l'utilisateur, qui
# assume le risque que le nœud MiniMaxH3TurboLoRA échoue à charger
# (incompatibilité AdaLN potentiellement toujours présente). En cas
# d'échec : soit re-télécharger manuellement
# minimax_h3_ref2va_pruned_int8_convrot.safetensors pour ce workflow
# précis, soit désactiver MINIMAX_H3_TURBO_LORA_AUTO_DOWNLOAD.
MINIMAX_H3_TURBO_LORA_URL="${MINIMAX_H3_TURBO_LORA_URL:-https://huggingface.co/drbaph/MiniMax-H3-Turbo-Lora-ComfyUI/resolve/main/minimax_h3_turbo_v4_step600_ema_pruned_comfyui.safetensors}"

# Nom local explicite du fichier une fois dans models/loras/. Sans cette
# variable (vide), install_lora.sh retombe sur son comportement historique
# (nom résolu depuis l'en-tête Content-Disposition pour CivitAI, ou dernier
# segment de l'URL pour un lien direct comme celui-ci) — voir --filename
# dans install_lora.sh. Fixée ici pour que ComfyUI affiche systématiquement
# ce nom stable dans le nœud MiniMaxH3TurboLoRA, quelle que soit l'URL
# source, et pour permettre l'idempotence sans recontacter Hugging
# Face/CivitAI uniquement pour redéterminer un nom déjà connu.
MINIMAX_H3_TURBO_LORA_FILENAME="${MINIMAX_H3_TURBO_LORA_FILENAME:-minimax_h3_turbo_v4_step600_ema_pruned_comfyui.safetensors}"

# ============================================================================
# Custom node Turbo MiniMax H3
# ============================================================================
# Dépôt fournissant les nœuds MiniMaxH3TurboLoRA et MiniMaxH3TurboSampler
# utilisés par les workflows Turbo. Installation volontairement séparée de
# OPTIONAL_NODE_REPOS(_NO_PIP) ci-dessus (lib/nodes.sh) : ces tableaux
# déclenchent un `git pull --ff-only` à chaque exécution d'install.sh/
# update.sh sur les dépôts déjà présents, alors que ce node Turbo doit
# rester figé une fois installé (pas de mise à jour automatique tant
# qu'elle n'est pas explicitement demandée — voir lib/lora_auto.sh::
# install_turbo_node()). Aucune dépendance Python (pas de requirements.txt
# dans ce dépôt), donc aucun pip install associé.
#
#   true  (défaut) : clone le dépôt s'il est absent.
#   false           : ne clone jamais — utile pour gérer ce node soi-même
#           (ComfyUI-Manager, installation manuelle...).
MINIMAX_H3_TURBO_NODE_AUTO_INSTALL="${MINIMAX_H3_TURBO_NODE_AUTO_INSTALL:-true}"
MINIMAX_H3_TURBO_NODE_REPO="${MINIMAX_H3_TURBO_NODE_REPO:-https://github.com/larryvrh/ComfyUI-MiniMax-H3-Turbo.git}"

# ============================================================================
# Composants optionnels
# ============================================================================
# Spectrum MiniMax H3 — nœud d'accélération optionnel pour MiniMax H3.
# Aucune dépendance Python (pas de requirements.txt dans ce dépôt) : il est
# donc ajouté à OPTIONAL_NODE_REPOS_NO_PIP plutôt qu'à OPTIONAL_NODE_REPOS.
# Mettre à "false" pour le désactiver complètement.
INSTALL_SPECTRUM="${INSTALL_SPECTRUM:-true}"
SPECTRUM_REPO="${SPECTRUM_REPO:-https://github.com/xmarre/ComfyUI-Spectrum-MiniMax-H3.git}"
if [[ "$INSTALL_SPECTRUM" == "true" ]]; then
  OPTIONAL_NODE_REPOS_NO_PIP+=("$SPECTRUM_REPO")
fi

# ============================================================================
# MiniMax H3
# ============================================================================
H3_HF_REPO="${H3_HF_REPO:-Comfy-Org/MiniMax-H3}"

# Dépôt HuggingFace tiers hébergeant les poids INT4 (palier "light" — voir
# H3_DIFFUSION_FL2VA/REF2VA dans lib/models.sh). Introduit pour que le projet
# ne dépende plus d'un unique dépôt : chaque entrée du manifeste des modèles
# porte désormais son propre dépôt (repo+filename), résolu et vérifié
# dynamiquement (licence, accès) par lib/huggingface.sh — voir
# hf_check_required_access(). Ajouter un futur dépôt tiers ne nécessite donc
# aucun hack : juste une nouvelle entrée de manifeste pointant vers lui.
H3_HF_REPO_INT4="${H3_HF_REPO_INT4:-tsolful/Minimax_H3_INT4MixedConvRot}"

# Workflows à installer
H3_WORKFLOWS="${H3_WORKFLOWS:-all}"

# Palier de poids par défaut. "auto" détecte la VRAM du GPU et choisit le
# palier le plus lourd qu'elle peut tenir, avec une marge de sécurité (voir
# H3_TIER_VRAM_SAFETY_MARGIN_GB dans la section GPU ci-dessous et
# lib/gpu.sh::detect_gpu). --tier=light / --tier=pruned /
# --tier=pruned_scaled / --tier=balanced / --tier=max (ou H3_TIER=...)
# forcent toujours un palier explicite, prioritaire sur l'auto-détection.
# "pruned_scaled" n'est jamais choisi par "auto" (repli manuel uniquement,
# voir lib/gpu.sh).
#
# Historique : ce projet ciblait à l'origine une RTX A6000 (48 Go) avec
# "max" figé par défaut. Des essais réels ont montré un OOM systématique sur
# cette carte avec ce palier (poids BF16) : pic mesuré ~48.2 Go pour 48 Go de
# VRAM disponible. La marge de sécurité ci-dessous corrige ce cas (et tout
# GPU de la même classe VRAM, ex. L40S, RTX 6000 Ada) sans toucher aux GPU
# qui ont réellement la VRAM pour "max" (A100/H100/H200).
H3_TIER="${H3_TIER:-auto}"

############################################################
# Model source
############################################################
MODEL_SOURCE="${MODEL_SOURCE:-huggingface}"
# Available values:
# huggingface
# civitai

# URLs CivitAI des modèles de diffusion (pruned INT8 ConvRot uniquement —
# seuls fichiers disponibles côté CivitAI pour H3). Depuis l'introduction du
# palier "light" en INT4Q (dépôt HuggingFace uniquement, voir H3_HF_REPO_INT4
# ci-dessus), ces poids pruned INT8 correspondent au palier "balanced", plus
# à "light" — MODEL_SOURCE=civitai n'est donc utilisable qu'avec
# H3_TIER=balanced (voir garde dans download_h3_models(), lib/models.sh).
# Utilisées uniquement si MODEL_SOURCE=civitai.
H3_CIVITAI_FL2VA_URL="${H3_CIVITAI_FL2VA_URL:-https://civitai.red/api/download/models/3193337?fileId=3074134}"
H3_CIVITAI_REF2VA_URL="${H3_CIVITAI_REF2VA_URL:-https://civitai.red/api/download/models/3193385?fileId=3074237}"

# ============================================================================
# Presets (jeux de modèles additionnels pour un workflow particulier)
# ============================================================================
# Un preset télécharge un jeu de fichiers modèles précis (souvent hors des
# trois paliers H3_TIER standard — checkpoints expérimentaux, dépôts tiers,
# etc.) et installe le workflow ComfyUI correspondant, EN PLUS de
# l'installation standard (palier H3_TIER + workflows H3_WORKFLOWS), sans
# jamais la modifier — SAUF pour les presets listés dans
# H3_PRESET_REPLACES_STANDARD_TIER ci-dessous (cf. juste en dessous). Ne rien
# renseigner ici (H3_PRESETS vide) reproduit exactement le comportement
# historique du projet.
#
# Activation : H3_PRESETS="dasiwa_mmh3v12" (config.env) ou
# --preset=dasiwa_mmh3v12 (ligne de commande, install.sh) — liste séparée
# par des virgules pour en activer plusieurs à la fois (ex.
# --preset=dasiwa_mmh3v12,autre_preset). Un jeton inconnu est ignoré avec un avertissement (voir resolve_h3_presets()
# dans lib/presets.sh), jamais une erreur bloquante.
#
# Défaut du projet (2026-08) : "dasiwa_mmh3v12" — décision explicite de
# l'utilisateur, qui juge ce workflow tiers (darksidewalker/DaSiWa-Nodes)
# suffisamment bon pour en faire l'usage principal. Repasser à vide pour
# revenir au comportement d'origine (aucun preset actif par défaut).
# NOTE : expansion SANS ":" (${H3_PRESETS-...}, pas "${H3_PRESETS:-...}")
# volontaire — un "${VAR:-défaut}" remplacerait aussi une valeur VIDE
# explicite par le défaut, ce qui empêcherait justement de désactiver le
# preset par défaut via H3_PRESETS="" (env) ou --preset= sans valeur. Seule
# une variable réellement NON définie doit recevoir "dasiwa_mmh3v12".
H3_PRESETS="${H3_PRESETS-dasiwa_mmh3v12}"

# Registre des presets connus — seule liste consultée pour valider
# H3_PRESETS/--preset= et composer les messages d'avertissement. Ajouter un
# preset : un nouveau nom ici, un tableau PRESET_<NOM_MAJUSCULE> ci-dessous
# (manifeste "repo|chemin_dans_le_repo|sous-dossier_local_models"), et
# éventuellement une entrée dans H3_PRESET_WORKFLOWS. Rien d'autre à modifier
# (lib/presets.sh reste générique).
H3_PRESET_NAMES=(dasiwa_mmh3v12 muse_director_seedhunt)

# Presets qui fournissent EUX-MÊMES un jeu complet fl2va/ref2va/text encoder
# (sous une autre précision/dépôt que le palier H3_TIER standard) plutôt que
# de simplement compléter l'install standard. Pour ceux-ci, retélécharger EN
# PLUS le palier H3_TIER standard ne ferait que dupliquer ~40-80 Go de poids
# qui remplissent le même rôle (fl2va/ref2va/text encoder) sous une
# précision différente, pour aucun bénéfice — donc install.sh saute
# entièrement download_h3_models() quand un preset de cette liste est actif
# (voir preset_replaces_standard_tier(), lib/presets.sh, et les deux points
# d'appel dans install.sh). "muse_director_seedhunt" y figure : il
# télécharge son propre couple fl2va/ref2va pruned INT8 ConvRot (même
# fichiers que dasiwa_mmh3v12, cf. PRESET_MUSE_DIRECTOR_SEEDHUNT ci-dessous),
# qui remplit exactement le même rôle que le palier standard — le retélécharger
# EN PLUS n'apporterait rien.
# shellcheck disable=SC2034  # lu par lib/presets.sh
H3_PRESET_REPLACES_STANDARD_TIER=(dasiwa_mmh3v12 muse_director_seedhunt)

# --- Preset "dasiwa_mmh3v12" -------------------------------------------------
# Workflow "DaSiWa - MiniMaxH3 MythicAlchemy v12" (T2VA/I2VA/FLF2VA/REF2VA) —
# checkpoints ConvRot INT8 FL2VA + REF2VA (dépôt Comfy-Org/MiniMax-H3, hors
# des trois paliers H3_TIER standard qui n'exposent que bf16/fp8_scaled/
# INT4Q), text encoder alternatif INT4 ConvRot (dépôt Abiray/MiniMax-H3-GGUF,
# tel que sélectionné dans le node Settings du workflow), VAE vidéo fp16 +
# VAE audio fp32 (repris ici pour un preset autonome — retéléchargement
# sauté s'ils sont déjà présents via l'installation standard), le TAE
# (aperçu rapide, dépôt Kijai/MiniMax-H3-TAE), le modèle d'upscale optionnel
# (2x-AnimeSharpV4_RCAN, dépôt Kim2091/2x-AnimeSharpV4 — fichier à la racine
# du repo, donc sous-dossier local upscale_models explicite) et le modèle
# d'interpolation de frames optionnel (rife_v4.26, dépôt
# Comfy-Org/frame_interpolation — chemin déjà dans un sous-dossier
# frame_interpolation/, donc sous-dossier local vide).
#
# --- Variante de checkpoint diffusion (H3_DASIWA_CHECKPOINT_VARIANT) -------
# EN: Lets the user pick which diffusion checkpoint(s) this preset installs,
# instead of always downloading the two official Comfy-Org pruned INT8
# ConvRot files (one for FL2VA — T2VA/I2VA/FLF2VA —, one for REF2VA). Two
# values:
#   - "pruned"       (default) — the two official Comfy-Org/MiniMax-H3
#                     pruned INT8 ConvRot checkpoints (FL2VA + REF2VA), same
#                     files used before this option existed. Recommended,
#                     well-tested. 2 files downloaded.
#   - "dasiwa_hybrid" — the single community "DaSiWa Hybrid" checkpoint
#                     (darksidewalker, published on CivitAI): NOT a
#                     REF2VA-only file — this one checkpoint handles BOTH
#                     roles (FL2VA and REF2VA) equally well, so only ONE
#                     file is downloaded and it is symlinked to both
#                     expected filenames (see PRESET_DASIWA_MMH3V12_SYMLINKS
#                     below). Experimental, not an official Comfy-Org
#                     release — opt-in only.
# Activation: H3_DASIWA_CHECKPOINT_VARIANT="dasiwa_hybrid" (config.env) or
# H3_DASIWA_CHECKPOINT_VARIANT=dasiwa_hybrid bash wizard.sh / install.sh
# (exported env var — same pattern as SAGE_ATTENTION/INSTALL_SPECTRUM, see
# wizard.sh). Any value other than "dasiwa_hybrid" resolves to "pruned".
#
# FR : Permet de choisir quel(s) checkpoint(s) de diffusion ce preset
# installe, plutôt que de toujours télécharger les deux fichiers officiels
# Comfy-Org pruned INT8 ConvRot (un pour FL2VA — T2VA/I2VA/FLF2VA —, un pour
# REF2VA). Deux valeurs possibles :
#   - "pruned"        (défaut) — les deux checkpoints pruned INT8 ConvRot
#                      officiels (FL2VA + REF2VA), les mêmes fichiers
#                      qu'avant l'ajout de cette option. Recommandé, éprouvé.
#                      2 fichiers téléchargés.
#   - "dasiwa_hybrid" — le checkpoint communautaire unique "DaSiWa Hybrid"
#                      (darksidewalker, publié sur CivitAI) : ce n'est PAS
#                      un fichier réservé au REF2VA — ce même checkpoint
#                      fait aussi bien pour le rôle FL2VA que pour le rôle
#                      REF2VA, donc UN SEUL fichier est téléchargé, et il
#                      est symlinké vers les deux noms attendus par le
#                      workflow (voir PRESET_DASIWA_MMH3V12_SYMLINKS
#                      ci-dessous). Expérimental, ce n'est pas une
#                      publication officielle Comfy-Org — activation
#                      volontaire uniquement.
# Le fichier est téléchargé PAR DÉFAUT depuis un dépôt HuggingFace privé
# miroir (H3_DASIWA_HYBRID_HF_REPO ci-dessous, "Kinderheim/private" par
# défaut) via le manifeste HuggingFace normal (download_hf_file(),
# lib/download.sh — protocole Xet, multi-connexions, même mécanisme que les
# 6 autres fichiers de ce preset) plutôt que depuis CivitAI en curl
# mono-flux (nettement plus lent, cf. CHANGELOG.md). CivitAI reste le
# fallback si H3_DASIWA_HYBRID_HF_REPO est explicitement mis à vide (voir
# PRESET_DASIWA_MMH3V12_CIVITAI_MODELS ci-dessous et la boucle CivitAI de
# download_preset_models(), lib/presets.sh), via download_civitai_model()
# (lib/models.sh). Le nom de fichier local choisi (H3_DASIWA_HYBRID_FILENAME)
# est volontairement distinct des deux fichiers officiels pour ne jamais en
# écraser un si l'utilisateur change de variante d'une installation à
# l'autre sur le même volume — c'est PRESET_DASIWA_MMH3V12_SYMLINKS (plus
# bas) qui fait pointer les DEUX noms attendus par le workflow (FL2VA et
# REF2VA) vers ce même fichier unique quand la variante est active.
#
# ⚠️ Le dépôt HuggingFace "Kinderheim/private" est gated (accès restreint,
# auto-approve) : chaque utilisateur doit d'abord se rendre une fois sur
# https://huggingface.co/Kinderheim/private/tree/main pendant qu'il est
# connecté à son compte HF et cliquer « Agree and access repository »
# (auto-approuvé instantanément, mais cette visite manuelle reste
# obligatoire — un HF_TOKEN seul ne suffit pas si le compte n'a jamais
# accepté la page, hf download renverrait un 403 sinon), PUIS créer un
# token personnel (lecture suffit) sur https://huggingface.co/settings/tokens
# et le passer en HF_TOKEN=xxxxx au lancement (le script fait déjà
# "hf auth login --token $HF_TOKEN" automatiquement, lib/huggingface.sh —
# rien d'autre à configurer côté auth). Exemple :
# HF_TOKEN=xxxxx H3_DASIWA_CHECKPOINT_VARIANT=dasiwa_hybrid bash install.sh --preset=dasiwa_mmh3v12
#
# Fallback CivitAI (H3_DASIWA_HYBRID_HF_REPO="" explicitement) : ce
# checkpoint communautaire est alors téléchargé en accès restreint sur
# CivitAI (identique à tout modèle marqué NSFW/soumis à connexion sur ce
# site) — nécessite une variable d'environnement CIVITAI_API_KEY définie
# (clé personnelle à créer sur https://civitai.com/user/account, section
# « API Keys »), faute de quoi CivitAI répond 401 quelle que soit
# l'exactitude de l'URL — voir download_civitai_model() (lib/models.sh) qui
# ajoute automatiquement l'en-tête "Authorization: Bearer $CIVITAI_API_KEY"
# dès qu'elle est définie (même convention que install_lora.sh). Exemple :
# CIVITAI_API_KEY=xxxxx H3_DASIWA_HYBRID_HF_REPO="" H3_DASIWA_CHECKPOINT_VARIANT=dasiwa_hybrid bash install.sh --preset=dasiwa_mmh3v12
#
# --- Persistance de ce choix entre redémarrages automatiques du conteneur --
# EN: On RunPod, docker-entrypoint.sh (PID 1 of the container) can restart
# itself automatically — OOM, spot interruption, network glitch during a
# huge download — WITHOUT that being a new pod. When it does, it re-execs
# install.sh with a fresh environment: any choice that only ever lived in a
# shell variable exported by wizard.sh for that one interactive run is
# gone, and this line's "${H3_DASIWA_CHECKPOINT_VARIANT:-pruned}" fallback
# silently applies — meaning a restart can silently switch you from
# "dasiwa_hybrid" back to "pruned" and re-download ~42 GB you didn't ask
# for. To prevent that, wizard.sh also writes the chosen variant to
# H3_USER_CHOICES_FILE below, on /workspace — RunPod's PERSISTENT volume,
# unlike PROJECT_ROOT (/opt/minimax-runpod-installer, baked into the image,
# wiped/reset on restart) where this repo and its state file
# (.minimax_installer_state) live. Sourced here ONLY if
# H3_DASIWA_CHECKPOINT_VARIANT isn't already set for this run, so an
# explicit env var (RunPod dashboard "Environment Variables" tab, or typed
# on the command line) always wins over the persisted file. This is a
# convenience default, not the safety mechanism: even if this file is
# missing/stale/wrong, download_preset_models() (lib/presets.sh) below
# still refuses to silently switch variants on disk without confirmation —
# see the "Garde d'autorisation" comment there.
#
# FR : Sur RunPod, docker-entrypoint.sh (PID 1 du conteneur) peut redémarrer
# tout seul — OOM, coupure spot, incident réseau pendant un gros
# téléchargement — SANS que ce soit un nouveau pod. Dans ce cas, il relance
# install.sh avec un environnement neuf : tout choix qui n'a vécu que dans
# une variable shell exportée par wizard.sh pour cette session interactive
# est perdu, et le repli "${H3_DASIWA_CHECKPOINT_VARIANT:-pruned}" de cette
# ligne s'applique alors silencieusement — un redémarrage peut donc te faire
# repasser de "dasiwa_hybrid" à "pruned" en silence et retélécharger ~42 Go
# non désirés. Pour éviter ça, wizard.sh écrit AUSSI le choix fait dans
# H3_USER_CHOICES_FILE ci-dessous, sur /workspace — le volume PERSISTANT de
# RunPod, contrairement à PROJECT_ROOT (/opt/minimax-runpod-installer, figé
# dans l'image, remis à zéro à chaque redémarrage) où vivent ce dépôt et son
# state file (.minimax_installer_state). Sourcé ici SEULEMENT si
# H3_DASIWA_CHECKPOINT_VARIANT n'est pas déjà positionnée pour ce run, pour
# qu'une variable d'environnement explicite (onglet "Environment Variables"
# du dashboard RunPod, ou tapée en ligne de commande) l'emporte toujours sur
# le fichier persisté. Ceci est un défaut de confort, pas le mécanisme de
# sécurité : même si ce fichier est absent/périmé/faux,
# download_preset_models() (lib/presets.sh, plus bas) refuse quand même de
# changer de variante sur disque sans confirmation — voir le commentaire
# "Garde d'autorisation" là-bas.
H3_USER_CHOICES_FILE="${H3_USER_CHOICES_FILE:-$(dirname "${INSTALL_DIR:-/workspace/ComfyUI}")/.minimax_user_choices.env}"
# Source le fichier de choix persisté (volume /workspace) si l'un des
# réglages DaSiWa n'est pas déjà positionné pour ce run — une variable
# d'environnement explicite (dashboard RunPod, ligne de commande) prime
# toujours. Un fichier hérité au format ancien (H3_DASIWA_CHECKPOINT_VARIANT
# seul) reste lu : la variante scalaire est normalisée ci-dessous puis
# reprise par H3_DASIWA_CHECKPOINT_VARIANTS dans la section manifeste.
if [[ -f "$H3_USER_CHOICES_FILE" ]] && [[ -z "${H3_DASIWA_MODE:-}" || -z "${H3_DASIWA_SPEED_PATH:-}" || -z "${H3_DASIWA_CHECKPOINT_VARIANTS:-}" || -z "${H3_DASIWA_CHECKPOINT_VARIANT:-}" ]]; then
  # shellcheck disable=SC1090
  source "$H3_USER_CHOICES_FILE"
fi
H3_DASIWA_CHECKPOINT_VARIANT="${H3_DASIWA_CHECKPOINT_VARIANT:-pruned}"
case "$H3_DASIWA_CHECKPOINT_VARIANT" in
  dasiwa_hybrid) ;;
  *) H3_DASIWA_CHECKPOINT_VARIANT="pruned" ;;
esac
# "-" (et non ":-") : permet à l'utilisateur de forcer explicitement le
# fallback CivitAI avec H3_DASIWA_HYBRID_HF_REPO="" (chaîne vide, variable
# DÉFINIE) sans que cela retombe silencieusement sur le défaut — seule une
# variable NON définie du tout reçoit "Kinderheim/private".
H3_DASIWA_HYBRID_HF_REPO="${H3_DASIWA_HYBRID_HF_REPO-Kinderheim/private}"
H3_DASIWA_HYBRID_CIVITAI_URL="${H3_DASIWA_HYBRID_CIVITAI_URL:-https://civitai.red/api/download/models/3251526?fileId=3135537}"
# Doit correspondre exactement au nom de fichier réel sur le dépôt HF
# ci-dessus (hf download reconstruit le chemin du dépôt tel quel, voir
# download_hf_file(), lib/download.sh) ; sert aussi de nom de fichier local
# dans le cas du fallback CivitAI (curl écrit sous ce nom, arbitraire dans
# ce cas).
H3_DASIWA_HYBRID_FILENAME="DasiwaMinimaxH3_dasiwaREF2VAHybridV1.safetensors"

# ============================================================================
# Mode du preset "dasiwa_mmh3v12" (H3_DASIWA_MODE) — redesign DaSiWa.
# ============================================================================
# classic  (défaut) : workflow "MythicAlchemy" classique — chargeur de
#           checkpoint standard, comportement historique STRICTEMENT
#           inchangé pour une installation existante (Option A, fallback
#           stable). H3_DASIWA_CHECKPOINT_VARIANT(s) choisit quel(s)
#           checkpoint(s) installer.
# director : mode Director du pack ComfyUI-DaSiWa-Nodes (nœuds
#           MiniMaxH3Director / MiniMaxH3DirectorGuide routant vers les
#           nœuds natifs MiniMaxH3ImageToVideo / MiniMaxH3ReferenceToVideo),
#           workflow C-MMH3-18 épinglé localement (H3_DASIWA_WORKFLOW_PIN),
#           checkpoint hybride choisi (H3_DASIWA_DIRECTOR_HYBRID_VARIANT),
#           VAE vidéo int8 Kijai + pack LBH installés automatiquement
#           (Option B). Défaut non cassant : une installation/choix hérité
#           sans cette variable = mode classic, identique à aujourd'hui.
H3_DASIWA_MODE="${H3_DASIWA_MODE:-classic}"
case "$H3_DASIWA_MODE" in
  classic|director) ;;
  *) H3_DASIWA_MODE="classic" ;;
esac

# --- Chemin de vitesse (H3_DASIWA_SPEED_PATH) — 4 chemins EXCLUSIFS --------
#   slow      : checkpoints officiels pruned + sampling lent (~25 steps,
#               recette classique). Défaut.
#   turbo_v4  : officiels pruned + Turbo LoRA v4 (6-8 steps, euler/beta,
#               node larryvrh/ComfyUI-MiniMax-H3-Turbo).
#   pdd       : officiels pruned + PDD sidecar fbjr (4-8 steps, euler/CFG1,
#               node MiniMaxH3PDDLoRA — version corrigée 29/08).
#   hybrid    : checkpoint hybride DaSiWa (v1 / 8Turbo / 4Turbo, un seul à
#               la fois). 8Turbo = défaut en mode director.
# Ces 4 chemins sont mutuellement exclusifs : les garde-fous (wizard.sh et
# _dasiwa_speed_guard dans lib/presets.sh) refusent de les empiler — un
# Turbo LoRA ne se cumule pas avec l'hybride déjà turbo, ni avec le PDD
# (distillations qui ne s'empilent pas, cf. rapport d'analyse).
H3_DASIWA_SPEED_PATH="${H3_DASIWA_SPEED_PATH:-slow}"

# --- Variante de checkpoint hybride (mode director, ou chemin "hybrid") ----
# Trois onglets de la fiche CivitAI modelId=2877206 ("DaSiWa MiniMax H3",
# Darksidewalker) :
#   hybrid_v1      — Hybrid v1 (sans distillation)
#   hybrid_8turbo  — Hybrid 8Turbo v1 (8 steps) — DÉFAUT Option B
#   hybrid_4turbo  — Hybrid 4Turbo v1 (4 steps)
# Chaque variante est un checkpoint UNIQUE (sert FL2VA ET REF2VA). Source
# primaire : dépôt HF gated "Kinderheim/private" (H3_DASIWA_HYBRID_HF_REPO,
# HF_TOKEN) ; repli : CivitAI (CIVITAI_API_KEY) via les URLs ci-dessous ;
# sans aucun token → message "téléchargement manuel guidé", jamais bloquant.
H3_DASIWA_DIRECTOR_HYBRID_VARIANT="${H3_DASIWA_DIRECTOR_HYBRID_VARIANT:-hybrid_8turbo}"

# Registre des fichiers hybrides, clé = variante.
#   H3_DASIWA_HYBRID_HF_NAMES   : nom du fichier sur le dépôt HF (vide =
#                                 variante absente du dépôt HF → CivitAI
#                                 uniquement, cas du 4Turbo aujourd'hui).
#   H3_DASIWA_HYBRID_CIVITAI_URLS : URL de repli CivitAI (fileId).
#   H3_DASIWA_HYBRID_SHA256     : SHA256 publié (contrôle post-téléchargement
#                                 en mode director, cf. lib/presets.sh).
declare -A H3_DASIWA_HYBRID_HF_NAMES=(
  [hybrid_v1]="DasiwaMinimaxH3_dasiwaREF2VAHybridV1.safetensors"
  [hybrid_8turbo]="DasiwaMinimaxH3_dasiwaHybrid8turboV1.safetensors"
  [hybrid_4turbo]=""
)
declare -A H3_DASIWA_HYBRID_CIVITAI_URLS=(
  [hybrid_v1]="https://civitai.com/api/download/models/3251526?fileId=3156811"
  [hybrid_8turbo]="https://civitai.com/api/download/models/3275408?fileId=3159579"
  [hybrid_4turbo]="https://civitai.com/api/download/models/3272675?fileId=3156813"
)
declare -A H3_DASIWA_HYBRID_SHA256=(
  [hybrid_v1]="2255091d505cb9205148f1ab5c9a6d2ac397226112e1882650b1451d12f74f25"
  [hybrid_8turbo]="e0441d26414f6e0c28f43d580e6cc56fad424da0fa4d261b698ca73188aa6332"
  [hybrid_4turbo]="56c52c7890c105308d28fe9c25c25fdb80e6cd6a54e2604d8af71732ba4ed74f"
)
# Nom PUBLIÉ (donc nom de fichier local après téléchargement), clé = variante.
# Identique au nom HF pour v1/8turbo ; distinct pour 4turbo (CivitAI only).
declare -A H3_DASIWA_HYBRID_PUBLISHED_NAMES=(
  [hybrid_v1]="DasiwaMinimaxH3_dasiwaREF2VAHybridV1.safetensors"
  [hybrid_8turbo]="DasiwaMinimaxH3_dasiwaHybrid8turboV1.safetensors"
  [hybrid_4turbo]="DasiwaMinimaxH3_dasiwaHybrid4turboV1.safetensors"
)

# Nom de fichier attendu par le workflow C-MMH3-18 pour le checkpoint
# hybride (node Settings, champs unet_fl2va ET unet_ref2va pointent ce même
# nom). C'est la CIBLE du symlink créé en mode director : le fichier publié
# téléchargé (nom ci-dessus) est symlinké vers ce nom sous
# diffusion_models/MiniMaxH3/. Le workflow n'est jamais édité.
H3_DASIWA_DIRECTOR_UNET_WORKFLOW_NAME="${H3_DASIWA_DIRECTOR_UNET_WORKFLOW_NAME:-dasiwa_minimax_h3_ref2va_v1_pruned_hybrid_bf16_m_8turbo_int8_row-wise_convrot_runtime_mixed.safetensors}"

# --- Option B (director) : dépendances OBLIGATOIRES ------------------------
# VAE vidéo INT8 ConvRot (Kijai/MiniMax-H3-experimental) — remplace le VAE
# vidéo fp16 dans le workflow C-MMH3-18. Installation automatique, NON
# optionnelle, quand H3_DASIWA_MODE=director.
H3_DASIWA_KIJAI_VAE_REPO="${H3_DASIWA_KIJAI_VAE_REPO:-Kijai/MiniMax-H3-experimental}"
H3_DASIWA_KIJAI_VAE_PATH="minimax_h3_video_vae_int8_convrot.safetensors"

# Custom node "Comfyui_Minimax_h3_latent_Upscaler" (LBH-123-AI) + modèle
# d'upscale latent 3D — requis par C-MMH3-18 (nœud MinimaxH3LatentUpscaler3D,
# mode mute par défaut). Installation manuelle documentée en amont : déclaré
# ici (repo de nœud + modèle) pour automatiser l'installation en mode
# director. Modèle → models/latent_upscale_models/.
H3_DASIWA_LBH_NODE_REPO="${H3_DASIWA_LBH_NODE_REPO:-https://github.com/LBH-123-AI/Comfyui_Minimax_h3_latent_Upscaler.git}"
H3_DASIWA_LBH_MODEL_REPO="${H3_DASIWA_LBH_MODEL_REPO:-LBH-123-AI/Minimax_h3_latent_Upscaler}"
H3_DASIWA_LBH_MODEL_PATH="minimax_h3_latent_upscaler_3d_bf16.safetensors"

# Épinglage du workflow (mode director) : chemin RELATIF au projet d'un
# fichier JSON figé, copié tel quel dans user/default/workflows — AU LIEU du
# sync GitHub "toutes versions" (H3_PRESET_WORKFLOW_GITHUB_SOURCES) qui
# tirerait automatiquement une future C-MMH3-19 et écraserait silencieusement
# la version validée. Ce fichier est versionné dans CE repo (git), donc
# insensible aux publications amont futures. Survit au prochain update.sh.
H3_DASIWA_WORKFLOW_PIN="${H3_DASIWA_WORKFLOW_PIN:-presets/dasiwa_mmh3v12/director/C-MMH3-18.json}"

# --- Construction du manifeste, mode-aware --------------------------------
# Rétro-compatibilité : l'ancienne variable scalaire
# H3_DASIWA_CHECKPOINT_VARIANT (pruned|dasiwa_hybrid) reste acceptée ; la
# nouvelle H3_DASIWA_CHECKPOINT_VARIANTS (CSV) la surcharge. Tokens officiels
# (paire fl2va+ref2va) : pruned (int8 convrot), pruned_scaled (fp8),
# pruned_bf16, dense_int8. Token communautaire : dasiwa_hybrid (hybride v1,
# fichier unique). Défaut : pruned (comportement historique).
H3_DASIWA_CHECKPOINT_VARIANTS="${H3_DASIWA_CHECKPOINT_VARIANTS:-${H3_DASIWA_CHECKPOINT_VARIANT:-pruned}}"

# _dasiwa_official_pair <quant> -> "fl2va_name ref2va_name" sur stdout
_dasiwa_official_pair() {
  case "$1" in
    pruned)         echo "minimax_h3_fl2va_pruned_int8_convrot.safetensors minimax_h3_ref2va_pruned_int8_convrot.safetensors" ;;
    pruned_scaled)  echo "minimax_h3_fl2va_pruned_fp8_scaled.safetensors minimax_h3_ref2va_pruned_fp8_scaled.safetensors" ;;
    pruned_bf16)    echo "minimax_h3_fl2va_pruned_bf16.safetensors minimax_h3_ref2va_pruned_bf16.safetensors" ;;
    dense_int8)     echo "minimax_h3_fl2va_int8_convrot.safetensors minimax_h3_ref2va_int8_convrot.safetensors" ;;
  esac
}

# _dasiwa_hybrid_active -> variante hybride active (clé du registre) sur stdout
_dasiwa_hybrid_active() {
  if [[ "$H3_DASIWA_MODE" == "director" ]]; then
    echo "${H3_DASIWA_DIRECTOR_HYBRID_VARIANT}"
  else
    echo "hybrid_v1"
  fi
}

# _dasiwa_hybrid_requested -> 0 si un checkpoint hybride est demandé
# (mode director, OU chemin "hybrid", OU token dasiwa_hybrid en classic).
_dasiwa_hybrid_requested() {
  [[ "$H3_DASIWA_MODE" == "director" ]] && return 0
  [[ "$H3_DASIWA_SPEED_PATH" == "hybrid" ]] && return 0
  [[ ",${H3_DASIWA_CHECKPOINT_VARIANTS}," == *",dasiwa_hybrid,"* ]] && return 0
  return 1
}

# --- Garde anti-empilement (silencieuse ici ; le wizard gère l'interactif) --
# Les 4 chemins vitesse sont MUTUELLEMENT EXCLUSIFS :
#   slow / turbo_v4 / pdd / hybrid.
# Normalisation du chemin vitesse, puis, si un checkpoint hybride est demandé
# (mode director, chemin "hybrid", ou token dasiwa_hybrid), le chemin est
# forcé à "hybrid" et les sidecars de distillation (Turbo LoRA v4, PDD) sont
# désactivés — un hybride déjà turbo ne se cumule pas avec un Turbo LoRA ni
# avec le PDD (distillations non empilables, cf. rapport d'analyse).
case "$H3_DASIWA_SPEED_PATH" in
  slow|turbo_v4|pdd|hybrid) ;;
  *) H3_DASIWA_SPEED_PATH="slow" ;;
esac
if [[ "$H3_DASIWA_MODE" == "director" ]]; then
  H3_DASIWA_SPEED_PATH="hybrid"
fi
if _dasiwa_hybrid_requested; then
  H3_DASIWA_SPEED_PATH="hybrid"
  MINIMAX_H3_TURBO_LORA_AUTO_DOWNLOAD="false"
  MINIMAX_H3_TURBO_NODE_AUTO_INSTALL="false"
fi

# shellcheck disable=SC2034  # lu par nameref dans lib/presets.sh
PRESET_DASIWA_MMH3V12=()

if [[ "$H3_DASIWA_MODE" == "director" ]]; then
  # Option B : VAE vidéo int8 Kijai (obligatoire) + audio fp32 + clip int4 +
  # TAE + upscale + rife + upscaler latent LBH. Le checkpoint hybride est
  # ajouté par le bloc hybride commun plus bas.
  PRESET_DASIWA_MMH3V12+=(
    "Abiray/MiniMax-H3-GGUF|text_encoders/qwen3vl_32b_minimax_h3_int4_convrot.safetensors|"
    "${H3_DASIWA_KIJAI_VAE_REPO}|${H3_DASIWA_KIJAI_VAE_PATH}|vae"
    "Comfy-Org/MiniMax-H3|vae/minimax_h3_audio_vae_fp32.safetensors|"
    "Kijai/MiniMax-H3-TAE|vae_approx/taeh3.safetensors|"
    "Kim2091/2x-AnimeSharpV4|2x-AnimeSharpV4_RCAN.safetensors|upscale_models"
    "Comfy-Org/frame_interpolation|frame_interpolation/rife_v4.26.safetensors|"
    "${H3_DASIWA_LBH_MODEL_REPO}|${H3_DASIWA_LBH_MODEL_PATH}|latent_upscale_models"
  )
else
  # Option A : paires officielles sélectionnées (multi), puis communs.
  declare -a _dw_variants=()
  IFS=',' read -ra _dw_variants <<< "$H3_DASIWA_CHECKPOINT_VARIANTS"
  for _dw_v in "${_dw_variants[@]}"; do
    [[ -z "$_dw_v" ]] && continue
    case "$_dw_v" in
      dasiwa_hybrid) ;;   # fichier unique, ajouté plus bas
      pruned|pruned_scaled|pruned_bf16|dense_int8)
        read -r _dw_fl2va _dw_ref2va < <(_dasiwa_official_pair "$_dw_v")
        PRESET_DASIWA_MMH3V12+=(
          "Comfy-Org/MiniMax-H3|diffusion_models/${_dw_fl2va}|"
          "Comfy-Org/MiniMax-H3|diffusion_models/${_dw_ref2va}|"
        )
        ;;
    esac
  done
  PRESET_DASIWA_MMH3V12+=(
    "Abiray/MiniMax-H3-GGUF|text_encoders/qwen3vl_32b_minimax_h3_int4_convrot.safetensors|"
    "Comfy-Org/MiniMax-H3|vae/minimax_h3_video_vae_fp16.safetensors|"
    "Comfy-Org/MiniMax-H3|vae/minimax_h3_audio_vae_fp32.safetensors|"
    "Kijai/MiniMax-H3-TAE|vae_approx/taeh3.safetensors|"
    "Kim2091/2x-AnimeSharpV4|2x-AnimeSharpV4_RCAN.safetensors|upscale_models"
    "Comfy-Org/frame_interpolation|frame_interpolation/rife_v4.26.safetensors|"
  )
fi

# --- Checkpoint hybride (commun classic "dasiwa_hybrid" et director) ------
# Ajouté au manifeste HuggingFace (hf download/Xet) si le dépôt HF est défini
# ET que la variante active y existe ; sinon manifeste CivitAI ci-dessous.
if _dasiwa_hybrid_requested; then
  _dw_hv="$(_dasiwa_hybrid_active)"
  _dw_hf_name="${H3_DASIWA_HYBRID_HF_NAMES[$_dw_hv]:-}"
  if [[ -n "$H3_DASIWA_HYBRID_HF_REPO" && -n "$_dw_hf_name" ]]; then
    PRESET_DASIWA_MMH3V12+=(
      "${H3_DASIWA_HYBRID_HF_REPO}|${_dw_hf_name}|diffusion_models"
    )
  fi
fi

# Manifeste CivitAI (repli, ou source si variante absente du dépôt HF).
# Format "url|chemin_relatif_a_models". Une entrée (fichier unique FL2VA+REF2VA).
# shellcheck disable=SC2034  # lu par nameref dans lib/presets.sh
PRESET_DASIWA_MMH3V12_CIVITAI_MODELS=()
if _dasiwa_hybrid_requested; then
  _dw_hv="$(_dasiwa_hybrid_active)"
  _dw_hf_name="${H3_DASIWA_HYBRID_HF_NAMES[$_dw_hv]:-}"
  _dw_civ_url="${H3_DASIWA_HYBRID_CIVITAI_URLS[$_dw_hv]:-}"
  _dw_pub="${H3_DASIWA_HYBRID_PUBLISHED_NAMES[$_dw_hv]:-}"
  # CivitAI utilisé si : dépôt HF vide, OU variante absente du HF (4turbo).
  if [[ -z "$H3_DASIWA_HYBRID_HF_REPO" || -z "$_dw_hf_name" ]]; then
    PRESET_DASIWA_MMH3V12_CIVITAI_MODELS=(
      "${_dw_civ_url}|diffusion_models/${_dw_pub}"
    )
  fi
fi

# Custom nodes requis par le workflow — dépôt darksidewalker/ComfyUI-DaSiWa-
# Nodes (nœuds DaSiWa_LTX2LoraLoader et le "Director"/"Guide" MiniMax H3 qui
# wrappe MiniMaxH3ImageToVideo / MiniMaxH3ReferenceToVideo) et city96/ComfyUI-
# GGUF (chargeurs UnetLoaderGGUF/CLIPLoaderGGUF — nécessaires dès qu'un
# checkpoint diffusion_models/text_encoders au format .gguf est sélectionné
# dans le node Settings du workflow, en complément des variantes
# safetensors int8_convrot/int4_convrot déjà couvertes par
# PRESET_DASIWA_MMH3V12 ci-dessus). rgthree-comfy (nœud "Label (rgthree)"
# utilisé par ce workflow) et ComfyUI-KJNodes sont déjà couverts par
# OPTIONAL_NODE_REPOS (ci-dessus, ligne ~46) — pas besoin de les redéclarer
# ici, ils sont installés pour toute installation standard, preset ou non.
# comfy-kitchen (bibliothèque de kernels accélérés FP8/NVFP4/INT8/ConvRot
# dont dépendent les checkpoints int8_convrot/int4_convrot de ce preset) est
# également déjà couvert, mais d'une façon encore différente : ce n'est ni
# un node repo ni un OPTIONAL_NODE_REPOS, c'est une dépendance pip épinglée
# dans le requirements.txt de ComfyUI lui-même, donc installée par
# install_comfyui_requirements() (lib/python.sh) sans rien à déclarer ici —
# voir la vérification post-install ajoutée dans lib/verify.sh
# (verify_installation) pour détecter un échec d'import silencieux.
# Même logique que PRESET_MUSE_DIRECTOR_SEEDHUNT_NODE_REPOS plus bas : scopé à
# ce preset précis via install_preset_nodes() (lib/presets.sh), jamais dans
# OPTIONAL_NODE_REPOS (aucun autre workflow standard n'a besoin de GGUF).
# shellcheck disable=SC2034  # lu par nameref dans lib/presets.sh
PRESET_DASIWA_MMH3V12_NODE_REPOS=(
  "https://github.com/darksidewalker/ComfyUI-DaSiWa-Nodes.git"
  "https://github.com/city96/ComfyUI-GGUF.git"
)
# Option B (director) : nœud d'upscale latent "Comfyui_Minimax_h3_latent_
# Upscaler" (LBH-123-AI), requis par C-MMH3-18 (nœud MinimaxH3LatentUpscaler3D,
# mode mute par défaut). Installation manuelle documentée en amont, automatisée
# ici via le même mécanisme que les autres nœuds de ce preset.
if [[ "$H3_DASIWA_MODE" == "director" && -n "$H3_DASIWA_LBH_NODE_REPO" ]]; then
  PRESET_DASIWA_MMH3V12_NODE_REPOS+=("$H3_DASIWA_LBH_NODE_REPO")
fi

# Les nœuds MiniMax H3 de DaSiWa-Nodes (UNETLoader/VAELoader du workflow)
# rangent leurs modèles dans un sous-dossier "MiniMaxH3/" (organisation
# propre à ce pack de nœuds — ex. "diffusion_models/MiniMaxH3/…"), alors que
# le manifeste PRESET_DASIWA_MMH3V12 ci-dessus les télécharge à la racine de
# diffusion_models/vae (chemin réel sur le dépôt Comfy-Org/MiniMax-H3, sans
# "MiniMaxH3"). Le manifeste ne peut pas exprimer ce renommage local sans
# casser l'URL de téléchargement (cf. commentaire de install_preset_symlinks(),
# lib/presets.sh) — d'où ces liens symboliques créés après coup, pour que le
# workflow retrouve ses 4 fichiers sans dupliquer ~25 Go sur disque.
#
# Les liens FL2VA + REF2VA (noms attendus par le workflow, inchangés quelle
# que soit la variante) pointent vers le(s) fichier(s) réel(s) de la
# variante H3_DASIWA_CHECKPOINT_VARIANT active ci-dessus :
#   - "pruned"        : deux fichiers réels distincts, un par rôle (comme
#                        avant l'ajout de cette option).
#   - "dasiwa_hybrid"  : LES DEUX liens pointent vers le MÊME fichier réel
#                        unique (H3_DASIWA_HYBRID_FILENAME) — ce checkpoint
#                        fait aussi bien pour FL2VA que pour REF2VA, donc
#                        pas de second téléchargement, juste un second lien
#                        symbolique vers le fichier déjà téléchargé.
# C'est le SEUL endroit où ce choix se répercute côté workflow : celui-ci
# continue de charger les deux mêmes noms de fichier dans tous les cas, sans
# rien à modifier dans le JSON.
# shellcheck disable=SC2034  # lu par nameref dans lib/presets.sh
PRESET_DASIWA_MMH3V12_SYMLINKS=()
if [[ "$H3_DASIWA_MODE" == "director" ]]; then
  # Option B : VAE vidéo int8 Kijai → sous-dossier MiniMaxH3/, + checkpoint
  # hybride → nom attendu par C-MMH3-18 (un seul nom, sert FL2VA+REF2VA).
  PRESET_DASIWA_MMH3V12_SYMLINKS+=(
    "vae/${H3_DASIWA_KIJAI_VAE_PATH}|vae/MiniMaxH3/${H3_DASIWA_KIJAI_VAE_PATH}"
    "vae/minimax_h3_audio_vae_fp32.safetensors|vae/MiniMaxH3/minimax_h3_audio_vae_fp32.safetensors"
  )
  _dw_hv="$(_dasiwa_hybrid_active)"
  _dw_pub="${H3_DASIWA_HYBRID_PUBLISHED_NAMES[$_dw_hv]:-}"
  PRESET_DASIWA_MMH3V12_SYMLINKS+=(
    "diffusion_models/${_dw_pub}|diffusion_models/MiniMaxH3/${H3_DASIWA_DIRECTOR_UNET_WORKFLOW_NAME}"
  )
else
  # Option A : VAE fp16 + audio, puis liens checkpoint selon variante(s).
  PRESET_DASIWA_MMH3V12_SYMLINKS+=(
    "vae/minimax_h3_video_vae_fp16.safetensors|vae/MiniMaxH3/minimax_h3_video_vae_fp16.safetensors"
    "vae/minimax_h3_audio_vae_fp32.safetensors|vae/MiniMaxH3/minimax_h3_audio_vae_fp32.safetensors"
  )
  if _dasiwa_hybrid_requested; then
    _dw_hv="$(_dasiwa_hybrid_active)"
    _dw_pub="${H3_DASIWA_HYBRID_PUBLISHED_NAMES[$_dw_hv]:-}"
    PRESET_DASIWA_MMH3V12_SYMLINKS+=(
      "diffusion_models/${_dw_pub}|diffusion_models/MiniMaxH3/minimax_h3_fl2va_pruned_int8_convrot.safetensors"
      "diffusion_models/${_dw_pub}|diffusion_models/MiniMaxH3/minimax_h3_ref2va_pruned_int8_convrot.safetensors"
    )
  fi
  # Paires officielles sélectionnées (une paire = deux liens).
  declare -a _dw_variants2=()
  IFS=',' read -ra _dw_variants2 <<< "$H3_DASIWA_CHECKPOINT_VARIANTS"
  for _dw_v in "${_dw_variants2[@]}"; do
    case "$_dw_v" in
      pruned|pruned_scaled|pruned_bf16|dense_int8)
        read -r _dw_fl2va _dw_ref2va < <(_dasiwa_official_pair "$_dw_v")
        PRESET_DASIWA_MMH3V12_SYMLINKS+=(
          "diffusion_models/${_dw_fl2va}|diffusion_models/MiniMaxH3/${_dw_fl2va}"
          "diffusion_models/${_dw_ref2va}|diffusion_models/MiniMaxH3/${_dw_ref2va}"
        )
        ;;
    esac
  done
fi

# --- Preset "muse_director_seedhunt" -----------------------------------------
# Nœud custom "Muse Minimax Director (Seed Hunt)" (dépôt muse-collective-26/
# MiniMaxH3-Director-Seed-Hunt) : éditeur de timeline (CUTs) au-dessus des
# nœuds stock MiniMaxH3ReferenceToVideo / MiniMaxH3ImageToVideo (gestion
# automatique du tag `<Picture N>`/`<Video N>`/`<Audio N>`, découpage en
# segments >~15s, mode Hybrid Continuation), avec un toggle "Seed Hunt" qui
# lance la timeline 4 fois à seeds différentes en basse résolution pour
# choisir le meilleur candidat avant d'affiner (nœud compagnon Muse Minimax
# Refine, dépôt séparé — cf. PRESET_MUSE_DIRECTOR_SEEDHUNT_NODE_REPOS
# ci-dessous : le workflow d'exemple bundlé le câble activement, ce n'est
# donc plus hors périmètre pour CE preset, malgré ce que disait une
# précédente version de ce commentaire).
#
# Modèles en pruned INT8 ConvRot (mêmes fichiers que PRESET_DASIWA_MMH3V12
# ci-dessus, dépôt Comfy-Org/MiniMax-H3 — retéléchargement sauté si déjà
# présents via ce ou un autre preset actif, download_hf_file() est
# idempotent) : fl2va requis pour le mode First/Last Frame et pour Hybrid
# Continuation en mode Reference, ref2va requis dans tous les cas (c'est le
# checkpoint câblé dans l'entrée `model` du nœud). Text encoder NVFP4 AWQ et
# VAE vidéo/audio repris du palier standard pour un preset autonome (mêmes
# repo+chemin que l'installation standard, donc déduplication automatique
# également). TAE (aperçu rapide) repris de PRESET_DASIWA_MMH3V12 : utilisé
# par le nœud ModelPreviewOverrideKJ (optionnel, cf.
# PRESET_MUSE_DIRECTOR_SEEDHUNT_NODE_REPOS ci-dessous) dans le workflow
# d'exemple bundlé.
#
# Deux entrées supplémentaires, câblées activement (mode=0, pas juste
# présentes en option désactivée) dans le workflow bundlé
# (presets/muse_director_seedhunt/muse_minimax_h3_director_scout_v1.json),
# identifiées en inspectant les widgets_values du JSON :
# - Turbo LoRA H3 4-step EMA (nœud LoraLoaderModelOnly, id 239, chemin local
#   attendu par le workflow : "H3\minimax_h3_turbo_..." — d'où le
#   sous-dossier loras/H3 ci-dessous) : dépôt drbaph/MiniMax-H3-Turbo-Lora-
#   ComfyUI, fichier à la racine du dépôt (aucun sous-dossier côté HF).
# - TAE "taeltx2_3.safetensors" (nœud VAELoader, id 147, alimente le second
#   ModelPreviewOverrideKJ via un couple SetNode/GetNode "TINY VAE") : dépôt
#   Kijai/LTX2.3_comfy (conçu pour LTX 2.3, pas MiniMax H3 — nom de fichier
#   et provenance vérifiés tels quels dans le JSON bundlé, le choix de ce TAE
#   précis pour la prévisualisation revient à l'auteur amont du workflow).
# shellcheck disable=SC2034  # lu par nameref dans lib/presets.sh
PRESET_MUSE_DIRECTOR_SEEDHUNT=(
  "Comfy-Org/MiniMax-H3|diffusion_models/minimax_h3_ref2va_pruned_int8_convrot.safetensors|"
  "Comfy-Org/MiniMax-H3|diffusion_models/minimax_h3_fl2va_pruned_int8_convrot.safetensors|"
  "Comfy-Org/MiniMax-H3|text_encoders/qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors|"
  "Comfy-Org/MiniMax-H3|vae/minimax_h3_video_vae_fp16.safetensors|"
  "Comfy-Org/MiniMax-H3|vae/minimax_h3_audio_vae_fp32.safetensors|"
  "Kijai/MiniMax-H3-TAE|vae_approx/taeh3.safetensors|"
  "drbaph/MiniMax-H3-Turbo-Lora-ComfyUI|minimax_h3_turbo_4step_ema_ckpt500_pruned_comfyui.safetensors|loras/H3"
  "Kijai/LTX2.3_comfy|vae/taeltx2_3.safetensors|"
)

# Nœuds custom du preset. rgthree-comfy et ComfyUI-KJNodes (nœud
# ModelPreviewOverrideKJ utilisé par le workflow d'exemple) et ComfyUI-
# VideoHelperSuite (VHS_VideoCombine, un par candidat Seed Hunt) sont déjà
# couverts par OPTIONAL_NODE_REPOS (ligne ~46) — pas besoin de les
# redéclarer ici. Les autres nœuds "convenience" mentionnés par le README
# amont (ComfyUI-LayerStyle, ComfyUI-Nvidia-RTX-Nodes,
# ComfyUI-Spectrum-MiniMax-H3, ComfyUI-SolAttn_triton) restent explicitement
# optionnels et non requis pour que MuseMinimaxDirector fonctionne — le
# README amont le dit lui-même — donc volontairement absents d'ici.
#
# Muse-MiniMax-H3-Refine et ComfyUI-iTools, en revanche, sont bien
# nécessaires pour que CE workflow d'exemple précis se charge sans erreur
# "pack de nœuds manquant" dans ComfyUI/Manager : le JSON bundlé câble
# activement (mode=0, pas désactivé) un MuseMinimaxRefine (id 194) et un
# iToolsPreviewText (id 171) — contrairement au reste des nœuds
# "convenience" ci-dessus, qui sont soit bypassés (mode: 4) soit optionnels
# au sens strict. Le README amont confirme que Muse Minimax Refine vit dans
# un dépôt séparé (pas dans MiniMaxH3-Director-Seed-Hunt lui-même, qui ne
# fournit que MuseMinimaxDirector) ; iToolsPreviewText, lui, peut être
# remplacé par n'importe quel autre nœud de prévisualisation STRING si on
# préfère ne pas installer ComfyUI-iTools — mais il est déclaré ici pour que
# le workflow se charge tel quel, sans édition manuelle.
# shellcheck disable=SC2034  # lu par nameref dans lib/presets.sh
PRESET_MUSE_DIRECTOR_SEEDHUNT_NODE_REPOS=(
  "https://github.com/muse-collective-26/MiniMaxH3-Director-Seed-Hunt.git"
  "https://github.com/muse-collective-26/Muse-MiniMax-H3-Refine.git"
  "https://github.com/MohammadAboulEla/ComfyUI-iTools.git"
)

# Dépendance pip du nœud ci-dessus (décodage/découpage des clips vidéo/audio
# de référence uploadés). Déclarée uniquement dans le README amont ("pip
# install av"), ni dans un requirements.txt ni dans le pyproject.toml du
# dépôt (vérifié) — _clone_or_update_node_repo() (lib/nodes.sh) ne lit que
# requirements.txt et ne l'installerait donc jamais automatiquement, d'où ce
# tableau dédié, lu par install_preset_pip_packages() (lib/presets.sh).
# shellcheck disable=SC2034  # lu par nameref dans lib/presets.sh
PRESET_MUSE_DIRECTOR_SEEDHUNT_PIP_PACKAGES=(
  "av"
)

# Workflow(s) ComfyUI bundlé(s) en repli local (chemin relatif à la racine du
# projet — un fichier "représentatif" par preset, uniquement utilisé pour
# nommer la cible du téléchargement CivitAI ci-dessous et pour l'avertissement
# "aucun workflow associé" ; le repli final effectif copie TOUS les .json du
# dossier presets/<nom>/, voir install_preset_workflows(), lib/presets.sh).
# Séparé de workflows/ et de install_workflows() (lib/workflows.sh), dont la
# ré-écriture de nom de fichier par palier (_patch_workflow_tier_filenames)
# ne doit jamais toucher aux noms de fichiers figés d'un preset.
declare -A H3_PRESET_WORKFLOWS=(
  [dasiwa_mmh3v12]="presets/dasiwa_mmh3v12/DaSiWa_MiniMaxH3_MythicAlchemy_v12.json"
  [muse_director_seedhunt]="presets/muse_director_seedhunt/muse_minimax_h3_director_scout_v1.json"
)

# Dépôt GitHub source pour un preset dont TOUTES les versions de workflow
# doivent être proposées, pas une seule figée arbitrairement côté
# installateur — format "owner/repo|branche|sous-dossier". Priorité la plus
# haute dans install_preset_workflows() (lib/presets.sh), avant même
# H3_PRESET_WORKFLOW_CIVITAI_URLS ci-dessous : _sync_preset_workflow_
# versions_from_github() récupère l'archive du dépôt (codeload.github.com,
# pas besoin de git ni d'authentification pour un dépôt public) et copie
# CHAQUE .json valide trouvé sous <sous-dossier>/ dans le dossier workflows
# de ComfyUI — une version amont = une entrée dans le menu "Load" de
# ComfyUI, à l'utilisateur de choisir celle qu'il préfère.
#
# dasiwa_mmh3v12 : darksidewalker publie ses workflows MiniMax H3
# ("MythicAlchemy") sous forme de fichiers numérotés (C-MMH3-10.json,
# -11.json, ... au fil des mises à jour) dans son dépôt officiel
# darksidewalker/dasiwa-comfyui-workflows, dossier C-MMH3/ — c'est la source
# que darksidewalker lui-même tient à jour (les uploads CivitAI en sont une
# republication, avec un nommage de version différent : ce qu'il publie sous
# le nom "v12"/"v15" sur CivitAI correspond, contenu identique fichier par
# fichier vérifié, à C-MMH3-12.json/C-MMH3-14.json ici — les numéros ne se
# correspondent pas 1:1, seul le contenu fait foi). Contrairement à l'ancien
# lien CivitAI direct ci-dessous (pointant une version de modèle CivitAI
# précise et figée pour toujours, sans notion de "dernière version" sur
# cette route de téléchargement — d'où la dérive constatée : la copie locale
# encore bundlée dans presets/dasiwa_mmh3v12/ contenait déjà 3 versions plus
# récentes que ce que ce lien récupérait), ce dépôt GitHub reflète toujours
# l'état actuel du travail de l'auteur, et une nouvelle version publiée en
# amont apparaît automatiquement au prochain install/update, sans
# modification de ce projet.
# shellcheck disable=SC2034  # lu par nameref dans lib/presets.sh
declare -A H3_PRESET_WORKFLOW_GITHUB_SOURCES=(
  [dasiwa_mmh3v12]="darksidewalker/dasiwa-comfyui-workflows|main|C-MMH3"
)

# URL de téléchargement direct CivitAI ("civitai.com/api/download/models/..."
# ou "civitai.red/...") pour un preset dont le workflow doit être récupéré
# depuis CivitAI plutôt que depuis la copie locale bundlée (H3_PRESET_
# WORKFLOWS) — repli utilisé uniquement si H3_PRESET_WORKFLOW_GITHUB_SOURCES
# ci-dessus n'est pas déclaré pour ce preset, ou échoue. À la différence
# d'un dépôt GitHub, une telle URL pointe une version de modèle CivitAI
# précise et figée : à réserver aux presets pour lesquels aucun dépôt GitHub
# source équivalent n'est disponible. Optionnel : un preset absent de ce
# tableau garde le comportement historique (copie locale uniquement). Voir
# install_preset_workflows() (lib/presets.sh) pour le détail des replis en
# cascade.
declare -A H3_PRESET_WORKFLOW_CIVITAI_URLS=(
)

# Épinglage de version de workflow par preset (H3_PRESET_WORKFLOW_PINS) :
# chemin relatif au projet d'un fichier .json figé, copié TEL QUEL dans
# user/default/workflows — priorité la plus haute dans
# install_preset_workflows(), AVANT même le sync GitHub "toutes versions".
# Sert au mode director de dasiwa_mmh3v12 : le workflow C-MMH3-18 doit
# survivre à une future C-MMH3-19 sans écrasement silencieux au prochain
# update.sh. Ce fichier est versionné dans CE repo (presets/<nom>/director/),
# donc insensible aux publications amont. Seul dasiwa_mmh3v12 l'utilise, et
# uniquement quand H3_DASIWA_MODE=director (renseigné conditionnellement
# ci-dessous) ; un preset absent de ce tableau garde le comportement
# historique (sync GitHub + replis).
# shellcheck disable=SC2034  # lu par nameref dans lib/presets.sh
declare -A H3_PRESET_WORKFLOW_PINS=(
)
if [[ "$H3_DASIWA_MODE" == "director" && -n "$H3_DASIWA_WORKFLOW_PIN" ]]; then
  H3_PRESET_WORKFLOW_PINS[dasiwa_mmh3v12]="$H3_DASIWA_WORKFLOW_PIN"
fi

# ============================================================================
# Téléchargement
# ============================================================================
# Hugging Face utilise exclusivement `hf download` (protocole Xet natif,
# voir lib/download.sh) — aria2c reste installé sur le système (lib/system.sh)
# pour un usage éventuel hors HF, mais n'est câblé à aucun téléchargement.
DOWNLOAD_MAX_RETRIES="${DOWNLOAD_MAX_RETRIES:-5}"

# Optimisations Hugging Face — HF_HUB_ENABLE_HF_TRANSFER a été retiré : cette
# variable est dépréciée et sans effet (silent no-op) dès lors que hf_xet est
# installé (cas par défaut depuis huggingface_hub>=0.32.0, voir requirements.txt) —
# tous les transferts passent alors par le protocole Xet, piloté par
# HF_XET_HIGH_PERFORMANCE ci-dessous. Voir CHANGELOG.md.
HF_XET_HIGH_PERFORMANCE="${HF_XET_HIGH_PERFORMANCE:-1}"

# Vérification SHA256 (laisser vide)
declare -A MODEL_SHA256=(
    [fl2va]=""
    [ref2va]=""
    [text_encoder]=""
    [video_vae]=""
    [audio_vae]=""
)

# ============================================================================
# Hugging Face
# ============================================================================
HF_TOKEN="${HF_TOKEN:-}"

# ============================================================================
# Stockage perso (LoRAs / presets / outputs), indépendant du Network Volume
# RunPod — voir lib/personal_storage.sh pour le mécanisme complet.
# ============================================================================
# PERSONAL_STORAGE_HF_REPO : dépôt Hugging Face de type "dataset", PRIVÉ, qui
# sert de coffre pour vos LoRAs perso (models/loras/personal/, distincts du
# Turbo LoRA officiel déposé directement dans models/loras/), vos presets
# perso (presets/personal/, distincts des presets versionnés dans ce repo),
# vos outputs générés (output/) et vos workflows ComfyUI perso
# (user/default/workflows/personal/, importés tels quels, sans patch) —
# quatre choses que le Network Volume RunPod (payant, lié à un seul
# datacenter) n'est pas obligé de porter.
#
# CONFIGURATION PERSO DÉCLARATIVE : deux fichiers texte optionnels à la
# racine de ce même dépôt HF (un par ligne, lignes vides et commençant par
# '#' ignorées) vous permettent de déclarer ce que VOUS voulez voir
# installé automatiquement sur chaque pod/conteneur qui restaure ce coffre —
# vous les éditez une fois sur huggingface.co (ou via `hf upload`), et c'est
# appliqué partout, sans ressaisie :
#   - loras_manifest.txt : une URL de LoRA par ligne (HF/CivitAI/lien
#     direct), second mot optionnel pour forcer le nom de fichier local.
#     Installés dans models/loras/manifest/ via install_lora.sh --manifest.
#   - nodes_manifest.txt : une URL de dépôt Git de nœud custom par ligne,
#     second mot optionnel "false" pour désactiver son requirements.txt.
#     Installés dans custom_nodes/ comme n'importe quel nœud optionnel.
# Voir lib/personal_storage.sh (section MANIFESTES de l'en-tête) pour le
# détail complet. PERSONAL_STORAGE_MANIFEST_LORAS_FILENAME et
# PERSONAL_STORAGE_MANIFEST_NODES_FILENAME (ci-dessous) permettent de
# renommer ces deux fichiers si besoin.
#
# Réutilise exactement le même token/la même authentification que
# lib/huggingface.sh (déjà utilisé pour télécharger les poids H3) : aucune
# nouvelle dépendance, aucun nouveau secret à gérer.
#
# Vide par défaut = fonctionnalité DÉSACTIVÉE (no-op silencieux dans
# sync_personal_storage_pull()/sync_personal_storage_push()). Pour l'activer :
#   1. Créez UNE FOIS, à la main, un dépôt privé sur https://huggingface.co
#      (type "Dataset"), ex: <votre-user>/minimax-runpod-perso — le compte
#      HF gratuit donne 100 Go de stockage privé, largement suffisant pour
#      cet usage (les poids H3, gérés séparément par lib/models.sh, n'ont pas
#      besoin d'être dupliqués ici).
#   2. Renseignez son identifiant ci-dessous, ex:
#        PERSONAL_STORAGE_HF_REPO="<votre-user>/minimax-runpod-perso"
# install.sh restaure ce coffre en tout début d'exécution (avant le
# lancement de ComfyUI) ; lancez `bash sync_push.sh` avant de terminate un
# pod pour y renvoyer vos ajouts (update.sh le fait aussi automatiquement en
# fin de mise à jour) — NB : sync_push.sh ne pousse jamais les deux
# manifestes ni workflows/, qui restent sous votre seul contrôle manuel
# (voir CONFIGURATION PERSO DÉCLARATIVE ci-dessus).
PERSONAL_STORAGE_HF_REPO="${PERSONAL_STORAGE_HF_REPO:-}"

# Nom des deux fichiers manifestes (racine du dépôt PERSONAL_STORAGE_HF_REPO
# ci-dessus) — à changer uniquement si "loras_manifest.txt"/
# "nodes_manifest.txt" entrent en conflit avec un usage que vous en faites
# déjà par ailleurs dans ce même dépôt.
PERSONAL_STORAGE_MANIFEST_LORAS_FILENAME="${PERSONAL_STORAGE_MANIFEST_LORAS_FILENAME:-loras_manifest.txt}"
PERSONAL_STORAGE_MANIFEST_NODES_FILENAME="${PERSONAL_STORAGE_MANIFEST_NODES_FILENAME:-nodes_manifest.txt}"

# PERSONAL_LORAS_GITHUB_RELEASE_URL : backend SECONDAIRE et optionnel, pour
# un socle de LoRAs FIGÉS uniquement (contenu qui ne change plus) — jamais
# pour les outputs, qui s'accumulent et pour lesquels GitHub n'est pas fait
# (limite de 2 Go/fichier). URL de la PAGE d'une release GitHub, ex:
#   PERSONAL_LORAS_GITHUB_RELEASE_URL="https://github.com/<user>/<repo>/releases/tag/<tag>"
# Lecture seule : chaque asset de la release est téléchargé (une seule fois,
# skip si déjà présent) dans models/loras/personal/ via `curl`, sans
# authentification requise si le dépôt est public — jamais de push dessus
# depuis ce projet. Indépendant de PERSONAL_STORAGE_HF_REPO ci-dessus : les
# deux backends peuvent cohabiter (HF pour ce qui bouge, GitHub Releases pour
# un socle de LoRAs qu'on ne repousse jamais). Vide par défaut = désactivé.
PERSONAL_LORAS_GITHUB_RELEASE_URL="${PERSONAL_LORAS_GITHUB_RELEASE_URL:-}"

# ============================================================================
# PyTorch
# ============================================================================
# Le build PyTorch (version + index CUDA) est choisi automatiquement selon
# le runtime CUDA détecté via nvidia-smi — voir PYTORCH_BUILD_TABLE dans
# lib/python.sh, seule source de vérité pour ces versions. Deux échappatoires
# indépendantes, toutes deux désactivées par défaut :
#
# PREFER_CUDA130 : le champ "CUDA Version" rapporté par nvidia-smi est
# normalement fiable (c'est la version CUDA maximale supportée par le
# pilote hôte), mais peut être rapporté de façon conservatrice sur certains
# pilotes. Si true, une tentative de build cu130 (le plus performant pour
# MiniMax H3) est faite même quand le CUDA détecté pointerait normalement
# vers un build plus ancien (ex: cu126) — SANS jamais risquer de casser le
# pod : PyTorch vérifie automatiquement (verify_cuda, lib/python.sh) que ce
# build cu130 fonctionne réellement une fois installé, et retombe seul,
# silencieusement, sur le build normalement associé au CUDA détecté si ce
# n'est pas le cas (pilote hôte réellement trop ancien pour cu130).
PREFER_CUDA130="${PREFER_CUDA130:-false}"
#
# TORCH_VERSION_OVERRIDE / TORCH_CUDA_INDEX_OVERRIDE : reproductibilité
# stricte — si les DEUX sont renseignées, ce build exact est installé tel
# quel, quel que soit le CUDA détecté, SANS repli automatique (contrairement
# à PREFER_CUDA130 ci-dessus) : à réserver à une installation déjà validée
# que vous voulez figer à l'identique. Vides par défaut (comportement
# automatique). Exemple :
#   TORCH_VERSION_OVERRIDE="2.12.0"
#   TORCH_CUDA_INDEX_OVERRIDE="cu130"
TORCH_VERSION_OVERRIDE="${TORCH_VERSION_OVERRIDE:-}"
TORCH_CUDA_INDEX_OVERRIDE="${TORCH_CUDA_INDEX_OVERRIDE:-}"

# ============================================================================
# GPU
# ============================================================================
MIN_VRAM_GB="${MIN_VRAM_GB:-8}"

# Seuils de VRAM brute (Go, tels que rapportés par nvidia-smi) au-delà
# desquels --tier=auto / H3_TIER=auto recommande "pruned", puis "balanced",
# puis "max". En dessous du seuil "pruned", "light" est utilisé. Gardez ces
# valeurs croissantes. "pruned_scaled" n'a volontairement pas de seuil ici :
# il n'est jamais choisi par auto (voir lib/gpu.sh), toujours manuel.
H3_TIER_MIN_VRAM_PRUNED_GB="${H3_TIER_MIN_VRAM_PRUNED_GB:-24}"
# "balanced" pointe maintenant vers pruned_bf16 (~40.2 Go, pleine précision
# élaguée) au lieu de l'ancien pruned_fp8_scaled (~21 Go) — seuil relevé en
# conséquence pour refléter le vrai besoin VRAM de ce palier.
H3_TIER_MIN_VRAM_BALANCED_GB="${H3_TIER_MIN_VRAM_BALANCED_GB:-40}"
H3_TIER_MIN_VRAM_MAX_GB="${H3_TIER_MIN_VRAM_MAX_GB:-48}"

# Marge de sécurité (Go) soustraite de la VRAM détectée avant de la comparer
# aux seuils ci-dessus. Le pic d'usage réel (allocateur CUDA, activations,
# overhead ComfyUI/PyTorch) dépasse la taille brute des poids : un GPU tout
# juste au seuil "max" (48 Go, ex. RTX A6000/L40S) peut donc OOM même s'il
# correspond nominalement au palier. Augmentez cette valeur si vous observez
# des OOM proches d'un changement de palier ; mettez-la à 0 pour retrouver
# les seuils bruts sans marge.
H3_TIER_VRAM_SAFETY_MARGIN_GB="${H3_TIER_VRAM_SAFETY_MARGIN_GB:-4}"

# --highvram côté ComfyUI garde en permanence tous les modèles (diffusion,
# text encoder, VAE) en VRAM et désactive l'offloading CPU<->GPU. Sur les
# workflows H3 Reference-to-Video, le pic réel dépasse régulièrement les
# 48 Go nominaux d'une RTX A6000 / RTX 6000 Ada, ce qui provoque un CUDA OOM
# systématique avec ce flag. Valeurs possibles :
# --highvram côté ComfyUI garde en permanence tous les modèles (diffusion,
# text encoder, VAE) en VRAM et désactive l'offloading CPU<->GPU.
#
# IMPORTANT (mis à jour) : ComfyUI utilise désormais DynamicVRAM par défaut
# sur NVIDIA + PyTorch 2.8+ + non-WSL (toujours le cas sur ce projet — voir
# PYTORCH_BUILD_TABLE, lib/python.sh) : ce système surveille la pression
# mémoire réelle PENDANT l'exécution et déplace les poids GPU/RAM/disque à
# la demande, bien plus fiable que l'ancienne estimation à l'avance.
# --highvram fait partie de la liste OFFICIELLE des flags qui DÉSACTIVENT
# DynamicVRAM (avec --disable-dynamic-vram, --gpu-only, --novram, --cpu) —
# le forcer revient donc à l'ancien système, plus sujet aux OOM. La
# recommandation communautaire actuelle (guide InstaSD MiniMax H3) est
# qu'à partir de 24 Go de VRAM, aucun flag de gestion mémoire manuel n'est
# nécessaire : DynamicVRAM s'en charge déjà mieux tout seul. Valeurs
# possibles :
#   auto  (défaut) : n'ajoute AUCUN flag de gestion VRAM sur les GPU
#           >= 24 Go (laisse DynamicVRAM opérer, y compris sur une
#           RTX A6000/6000 Ada 48 Go) ; garde un repli
#           --lowvram --reserve-vram 1 en dessous de 24 Go.
#   true  : force --highvram — DÉCONSEILLÉ (désactive DynamicVRAM), à
#           réserver au debug ou à un besoin explicite de tout garder en
#           VRAM sans aucun offloading.
#   false : ne force jamais --highvram, sans changer le comportement
#           en dessous de 24 Go (identique à "auto" pour la partie
#           >= 24 Go).
COMFY_HIGHVRAM="${COMFY_HIGHVRAM:-auto}"

# ComfyUI (fonctionnalité "Dynamic VRAM") verrouille en RAM hôte ("pin",
# mémoire page-lockée) jusqu'à ~90% de la RAM vue par le processus pendant
# le chargement des modèles, pour accélérer les transferts CPU->GPU. Sur un
# pod RunPod (ou tout hébergeur conteneurisé), la RAM "vue" par le processus
# est souvent celle de la machine hôte physique (des centaines de Go), pas
# la limite réellement allouée au pod par son cgroup (ex. 50 Go). Quand le
# cumul des poids page-lockés dépasse cette limite cgroup, le noyau tue le
# processus (SIGKILL, cgroup OOM) sans traceback Python ni erreur CUDA — cas
# diagnostiqué sur ce projet (RTX A6000, pod limité à 50 Go côté cgroup
# malgré 500+ Go visibles côté machine hôte, crash systématique juste après
# le chargement du modèle de diffusion). --disable-pinned-memory (flag
# officiel ComfyUI) évite ce mode de défaillance, au prix d'un chargement de
# modèle un peu plus lent (RAM classique, "swappable"). Valeurs possibles :
#   auto  (défaut) : ajoute --disable-pinned-memory uniquement si la limite
#           mémoire réellement détectée pour ce pod (cgroup v2/v1, avec
#           repli sur la RAM totale hôte si aucun cgroup n'est actif — voir
#           detect_system_ram() dans lib/gpu.sh) est sous
#           H3_MIN_RAM_FOR_PINNED_MEMORY_GB ci-dessous. Laisse le pinning
#           actif (perf max) sur les pods qui ont réellement la RAM pour.
#   true  : force --disable-pinned-memory quelle que soit la RAM détectée.
#   false : ne jamais désactiver le pinning (comportement ComfyUI par
#           défaut) — à réserver aux pods dont la RAM est garantie large.
COMFY_PINNED_MEMORY="${COMFY_PINNED_MEMORY:-auto}"

# Seuil (Go) utilisé par COMFY_PINNED_MEMORY=auto ci-dessus. Calibré sur le
# pic observé au palier de poids H3 le plus lourd ("max", BF16) chargé
# simultanément en RAM pinnée — VAE + text encoder + modèle de diffusion,
# ~60-65 Go avant marge — de façon à rester valable quel que soit le palier
# H3_TIER effectivement utilisé (un palier plus léger consommera moins,
# jamais plus). Le pinning ComfyUI ne verrouillant qu'~90% de la RAM
# détectée, un pod dont la limite mémoire dépasse ce seuil garde ~10% de
# marge structurelle en plus. Augmentez cette valeur si vous observez encore
# des SIGKILL proches du seuil ; réduisez-la si vous utilisez uniquement le
# palier "light" et voulez garder le pinning actif sur des pods plus petits.
H3_MIN_RAM_FOR_PINNED_MEMORY_GB="${H3_MIN_RAM_FOR_PINNED_MEMORY_GB:-80}"

# ComfyUI ("smart memory") garde en cache VRAM les modèles récemment
# utilisés au lieu de les décharger vers la RAM dès qu'ils ne servent plus,
# pour accélérer les générations consécutives. Sur les workflows H3 (32 Go
# de diffusion + 26 Go de text encoder int8 + VAE, chargés successivement),
# ce cache spéculatif laisse trop peu de marge VRAM au moment du décodage ou
# du sampling suivant sur une carte à 48 Go tout juste — OOM observés à la
# fois en sampling et en VAE decode, de façon non parfaitement reproductible
# d'un run à l'autre (dépend de ce que le cache a choisi de garder).
# --disable-smart-memory (flag officiel ComfyUI) force un déchargement
# immédiat des modèles inutilisés vers la RAM hôte au lieu de les garder en
# cache VRAM.
#
# Choix empirique, pas une règle générale de gestion mémoire ComfyUI :
# activé sur les machines à RAM large sur la base des tests effectués avec
# MiniMax H3 (RTX A6000 48 Go, RunPod, 500+ Go de RAM hôte) — a éliminé les
# OOM observés jusqu'à 15 s / 2.0 MP, contre des échecs fréquents et non
# reproductibles sans ce flag. Aucune garantie que ce comportement reste
# optimal si un futur ComfyUI change sa gestion mémoire ("smart memory"),
# ou pour d'autres modèles/workflows que MiniMax H3 — voir la note de
# portée ci-dessous.
#
# Ce n'est PAS un flag universellement bénéfique : sur une machine où la RAM
# hôte est elle-même la ressource contrainte (typiquement < 32 Go), forcer
# ce déchargement supplémentaire vers la RAM peut aggraver la pression
# mémoire plutôt que la soulager (cas documenté par des tiers sur RTX 3090 /
# 31 Go de RAM — voir TROUBLESHOOTING.md). Sur les pods RunPod visés
# par ce projet (RAM hôte très largement supérieure à ce que H3 utilise),
# ce cas ne s'applique pas.
#
# Portée : ce flag est un argument de lancement de main.py, donc appliqué à
# tout le process ComfyUI — pas seulement à MiniMax H3. Il n'a été testé que
# sur le pipeline H3 de ce projet ; si vous chargez d'autres modèles/
# workflows dans la même instance ComfyUI (via ComfyUI-Manager par ex.), ce
# flag s'appliquera à eux aussi, sans validation de notre part sur ces cas.
# Valeurs possibles :
#   auto  (défaut) : active --disable-smart-memory uniquement si la RAM
#           allouée à ce pod atteint H3_MIN_RAM_FOR_SMART_MEMORY_GB
#           ci-dessous — c'est-à-dire sur les pods déjà considérés "RAM
#           large" par ce projet. En dessous, laisse le comportement par
#           défaut de ComfyUI (pas de sur-déchargement forcé vers une RAM
#           elle-même limitée).
#   true  : force --disable-smart-memory quelle que soit la RAM détectée.
#   false : ne jamais l'ajouter (comportement ComfyUI par défaut) — utile si
#           un futur ComfyUI ou comfy-kitchen rend ce contournement inutile,
#           sans avoir à toucher au code.
COMFY_SMART_MEMORY="${COMFY_SMART_MEMORY:-auto}"

# Seuil (Go) utilisé par COMFY_SMART_MEMORY=auto ci-dessus. Décision
# indépendante de H3_MIN_RAM_FOR_PINNED_MEMORY_GB — les deux protègent
# contre des modes de défaillance différents (SIGKILL cgroup pendant le
# chargement pour l'un, pression RAM liée au déchargement forcé de modèles
# pour l'autre) et n'ont pas de raison de varier ensemble si de futurs tests
# montrent des besoins différents. Même valeur par défaut aujourd'hui car
# calibrée sur les mêmes tests initiaux (RTX A6000, RunPod).
H3_MIN_RAM_FOR_SMART_MEMORY_GB="${H3_MIN_RAM_FOR_SMART_MEMORY_GB:-80}"

# Backend d'attention ComfyUI (lib/optimization.sh, section "attention
# backend"). Par défaut, xFormers est utilisé silencieusement dès qu'il est
# installé dans le venv (aucun flag ComfyUI ajouté : c'est le comportement
# natif de ComfyUI dès que le paquet est importable) ; --use-pytorch-cross-
# attention n'est ajouté qu'en repli, si xFormers est absent. Valeurs
# possibles :
#   auto     (défaut) : comportement ci-dessus — xFormers s'il est présent,
#             sinon --use-pytorch-cross-attention.
#   pytorch  : force --use-pytorch-cross-attention, MÊME si xFormers est
#             installé dans le venv (le flag CLI a priorité sur la
#             sélection automatique de ComfyUI). Utile si vous préférez
#             volontairement l'attention native PyTorch (SDPA), par ex.
#             pour éviter la marge d'incompatibilité/latence propre à
#             xFormers sur un GPU/CUDA donné.
#   xformers : force l'usage de xFormers (aucun flag ajouté, comme "auto"
#             quand xFormers est présent) et log une ERREUR s'il est
#             absent du venv, au lieu du repli silencieux de "auto" — utile
#             pour être notifié explicitement plutôt que de découvrir après
#             coup que le repli a été utilisé.
# N'a aucun effet sur SageAttention (patch appliqué par les nœuds custom du
# workflow lui-même, cf. lib/python.sh::install_sageattention — mécanisme
# entièrement différent, indépendant de ce réglage).
COMFY_ATTENTION_BACKEND="${COMFY_ATTENTION_BACKEND:-auto}"

# ============================================================================
# Lancement
# ============================================================================
COMFYUI_PORT="${COMFYUI_PORT:-8188}"
COMFYUI_LISTEN="${COMFYUI_LISTEN:-0.0.0.0}"

# Arguments supplémentaires ComfyUI
EXTRA_LAUNCH_ARGS="${EXTRA_LAUNCH_ARGS:---preview-method auto --enable-cors-header}"

# ============================================================================
# Notifications (ntfy.sh) — voir lib/notify.sh
# ============================================================================
# NTFY_TOPIC : interrupteur principal. Vide par défaut = toutes les
# notifications désactivées (no-op silencieux partout où elles sont
# appelées). Pour activer : choisissez un nom de topic difficile à deviner
# (n'importe qui connaissant ce nom peut s'y abonner ET y publier — ntfy.sh
# public n'a pas d'authentification par défaut), ex:
#   NTFY_TOPIC="minimax-h3-<un-suffixe-perso-que-vous-inventez>"
# puis abonnez-vous à ce même topic depuis l'app ntfy (Android/iOS/web) —
# aucun compte ni token requis. Pour un serveur ntfy auto-hébergé plutôt que
# le service public, changez aussi NTFY_SERVER ci-dessous.
NTFY_TOPIC="${NTFY_TOPIC:-}"
NTFY_SERVER="${NTFY_SERVER:-https://ntfy.sh}"

# Bascules indépendantes (n'ont d'effet que si NTFY_TOPIC est renseigné) :
#   - pod prêt : ComfyUI vient de répondre pour la première fois sur son port
#   - génération : un nouveau fichier stable est apparu dans output/
#   - inactivité : aucune génération depuis NOTIFY_INACTIVITY_MINUTES —
#     rappel pour ne pas laisser un pod GPU tourner (facturé) pour rien.
#     0 = désactive ce rappel spécifiquement, sans toucher aux deux autres.
NOTIFY_ON_READY="${NOTIFY_ON_READY:-true}"
NOTIFY_ON_GENERATION="${NOTIFY_ON_GENERATION:-true}"
NOTIFY_ON_INACTIVITY="${NOTIFY_ON_INACTIVITY:-true}"
NOTIFY_INACTIVITY_MINUTES="${NOTIFY_INACTIVITY_MINUTES:-60}"

# Fréquence (secondes) à laquelle output/ est scruté pour détecter une
# nouvelle génération — par sondage (pas d'inotify, pour ne pas ajouter de
# dépendance système). Descendre en dessous de 5s a peu d'intérêt (une
# génération vidéo prend de toute façon largement plus longtemps).
NOTIFY_OUTPUT_POLL_SECONDS="${NOTIFY_OUTPUT_POLL_SECONDS:-10}"